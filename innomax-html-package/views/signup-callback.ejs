<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Email Confirmation</title>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --dark-gold: #855e1b;
      --light-gold: #E6C373;
      --accent-gold: #D4AF37;
      --input-border: rgba(133, 94, 27, 0.3);
      --bg-gradient: linear-gradient(135deg, #000000, #000000);
      --card-bg: rgba(14, 14, 14, 0.98);
      --text-color: #333333;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: var(--bg-gradient);
      min-height: 100vh;
      font-family: 'Poppins', sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      color: var(--text-color);
      position: relative;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at 30% 50%, rgba(212, 175, 55, 0.06), transparent 60%),
                  radial-gradient(circle at 70% 20%, rgba(212, 175, 55, 0.06), transparent 60%);
      z-index: 0;
    }

    .confirmation-container {
      background: var(--card-bg);
      padding: 50px 40px;
      border-radius: 24px;
      width: 90%;
      max-width: 520px;
      box-shadow: 0 15px 50px rgba(0, 0, 0, 0.3),
                  0 0 60px rgba(230, 195, 115, 0.2);
      position: relative;
      overflow: hidden;
      z-index: 1;
      text-align: center;
    }

    .confirmation-container::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 10px;
      height: 100%;
      background: linear-gradient(to bottom, var(--dark-gold), var(--light-gold));
      border-top-left-radius: 24px;
      border-bottom-left-radius: 24px;
    }

    .logo {
      width: 80px;
      margin: 0 auto 20px;
    }

    .confirmation-container h3 {
      font-family: 'Cinzel', serif;
      color: var(--dark-gold);
      margin-bottom: 20px;
      font-size: 32px;
      font-weight: 600;
      letter-spacing: 1px;
    }

    .confirmation-container p {
      margin-bottom: 1.5rem;
      color: var(--dark-gold);
      line-height: 1.6;
      font-size: 1rem;
    }

    .link-btn {
      padding: 0.875rem 1.5rem;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      font-weight: 500;
      font-size: 0.9375rem;
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(45deg, var(--dark-gold), var(--light-gold));
      color: #fff;
      box-shadow: 0 4px 15px rgba(133, 94, 27, 0.3);
      transition: all 0.3s ease;
    }

    .link-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 6px 20px rgba(133, 94, 27, 0.4);
    }

    #resendStatus {
      color: var(--light-gold);
      margin-top: 1rem;
      display: none;
    }

    @media (max-width: 768px) {
      .confirmation-container {
        padding: 40px 30px;
        width: 95%;
      }

      .confirmation-container h3 {
        font-size: 28px;
      }
    }
  </style>
</head>
<body>
  <div class="confirmation-container" role="dialog" aria-labelledby="confirmationTitle" aria-describedby="confirmationDesc">
    <img src="assets/img/logo/cropped-LogoPB512gold-1.webp" alt="Company Logo" class="logo" />
    <h3 id="confirmationTitle">Email Confirmation</h3>
    <p id="confirmationDesc"></p>
    <button class="link-btn" onclick="resendConfirmation()">Resend Confirmation Email</button>
    <p id="resendStatus">Email resent successfully!</p>
  </div>

  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const email = sessionStorage.getItem('signupInfo');
      if (email) {
        const desc = document.getElementById('confirmationDesc');
        desc.innerHTML = `A confirmation email has been sent to your email address | <strong>${email}</strong> |. Please check your inbox and follow the instructions to complete your registration.`;
        
        // Start checking for confirmation
        startConfirmationCheck(email);
      }
    });
  
    function startConfirmationCheck(email) {
      const checkInterval = 5000; // Check every 5 seconds
      
      const checkConfirmation = async () => {
        
        try {
          const response = await fetch('/api/auth/check-confirmation', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ email })
          });
          
          const data = await response.json();
          
          if (data.confirmed) {
            // Show success message
            const desc = document.getElementById('confirmationDesc');
            desc.innerHTML = `Thank you! Your email <strong>${email}</strong> has been confirmed successfully.`;
            
            setTimeout(() => {
                // goes to login page
              window.location.href = '/login';
            }, 3000);
            
            // // Clear the session storage
            // sessionStorage.removeItem('signupInfo');
          } 
        } catch (error) {
          console.error('Error checking confirmation:', error);
        //   window.location.href = '/login';
          
        }
      };
      
      // Start the periodic check
      const intervalId = setInterval(checkConfirmation, checkInterval);
      // Initial check
      checkConfirmation();
    }
  
    function resendConfirmation() {
      const statusElement = document.getElementById('resendStatus');
      statusElement.style.display = 'block';
      setTimeout(() => {
        statusElement.style.display = 'none';
      }, 3000);
      
      // Add your resend confirmation email logic here
    }
  </script>
</body>
</html>
