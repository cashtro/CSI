<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Email Confirmed</title>
  <style>
    :root {
      --dark-gold: #855e1b;
      --light-gold: #E6C373;
      --accent-gold: #D4AF37;
      --input-border: rgba(133, 94, 27, 0.3);
      --bg-gradient: linear-gradient(135deg, #000000, #000000);
      --card-bg: rgba(14, 14, 14, 0.98);
      --text-color: #333333;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: var(--bg-gradient);
      min-height: 100vh;
      font-family: 'Poppins', sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      color: var(--text-color);
      position: relative;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at 30% 50%, rgba(212, 175, 55, 0.06), transparent 60%),
                  radial-gradient(circle at 70% 20%, rgba(212, 175, 55, 0.06), transparent 60%);
      z-index: 0;
    }

    .confirmation-container {
      background: var(--card-bg);
      padding: 50px 40px;
      border-radius: 24px;
      width: 90%;
      max-width: 520px;
      box-shadow: 0 15px 50px rgba(0, 0, 0, 0.3),
                  0 0 60px rgba(230, 195, 115, 0.2);
      position: relative;
      overflow: hidden;
      z-index: 1;
      text-align: center;
    }

    .confirmation-container::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 10px;
      height: 100%;
      background: linear-gradient(to bottom, var(--dark-gold), var(--light-gold));
      border-top-left-radius: 24px;
      border-bottom-left-radius: 24px;
    }

    .confirmation-container h3 {
      font-family: 'Cinzel', serif;
      color: var(--dark-gold);
      margin-bottom: 20px;
      font-size: 32px;
      font-weight: 600;
      letter-spacing: 1px;
    }

    .confirmation-container p {
      margin-bottom: 1.5rem;
      color: var(--dark-gold);
      line-height: 1.6;
      font-size: 1rem;
    }

    @media (max-width: 768px) {
      .confirmation-container {
        padding: 40px 30px;
        width: 95%;
      }

      .confirmation-container h3 {
        font-size: 28px;
      }
    }
  </style>
</head>
<body>
  <div class="confirmation-container">
    <h3>Email Confirmed</h3>
    <p>You may now close this tab.</p>
  </div>
</body>
</html>
