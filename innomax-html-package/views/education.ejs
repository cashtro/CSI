                                        <p><i class="fas fa-user"></i> <%= course.prof_name %></p>
                                        <p><i class="fas fa-clock"></i> <%= course.nombre_heures %>  hours of content</p>
                                        <p><i class="fas fa-signal"></i> Level: <%= course.niveau %></p>
                                    </div>
                                    <div class="price-tag" style="margin: 10px auto;"><%= course.prix  %> $</div>
                                    <div class="d-flex justify-content-center align-items-center" style="margin-top: 15px;">
                                        <a href="/course-details/<%= course.id %>" class="Btn" style="margin-right: 8px;">View Course</a>
                                        <a href="#" 
                                           class="Btn" 
                                           style="margin-left: 8px;" 
                                           onclick="event.preventDefault(); enrollCourse('<%= course.id %>');">
