                <script>
                    // Version améliorée avec gestion d'erreur et délai d'attente
                    document.addEventListener('DOMContentLoaded', function () {
                        function adjustRowClasses() {
                            // Sélectionne TOUTES les rows (au cas où il y en aurait plusieurs)
                            const rows = document.querySelectorAll('.row.row-cols-2.row-cols-md-3.row-cols-lg-5.g-4');

                            rows.forEach(row => {
                                if (window.innerWidth < 768) {
                                    row.className = 'row'; // Version mobile simple
                                } else if (window.innerWidth < 992) {
                                    row.className = 'row row-cols-md-3 g-4'; // Version tablette
                                } else {
                                    row.className = 'row row-cols-lg-5 g-4'; // Version desktop
                                }
                            });
                        }

                        // Exécute immédiatement et au redimensionnement
                        adjustRowClasses();
                        window.addEventListener('resize', adjustRowClasses);

                        // Sécurité supplémentaire
                        setTimeout(adjustRowClasses, 100);
                    });
                </script>
                                                       
