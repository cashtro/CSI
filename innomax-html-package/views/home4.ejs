<style>
/* Assure que ton parent est bien relatif */
.cd-service_wrap {
  position: relative;
}

/* Ton image décorative */
.cs-ser_shape {
  position: absolute !important;
  left: 50% !important;
  bottom: 50px !important;
  transform: translateX(-50%) !important;
  width: 200px !important;
  z-index: 0 !important;
  pointer-events: none !important;
}

.cs-ser_shape img {
  display: block;
  width: 100% !important;
  height: auto !important;
}

@media (max-width: 992px) {
  .cd-service_wrap {
    position: relative;
    overflow: visible; /* ou hidden si tu veux couper le dépassement */
    padding-bottom: 150px; /* 👈 Ajoute de la place en bas si besoin */
  }

  .cs-ser_shape {
    width: 120px !important;
    bottom: 0px !important;  /* ✅ Valeur POSITIVE pour rester dedans */
    z-index: 0 !important;
    pointer-events: none !important;
  }

  .cs-service-item {
    position: relative;
    z-index: 2;  /* toujours au-dessus du logo */
  }
}


</style>
