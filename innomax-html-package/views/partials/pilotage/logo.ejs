<%#
  Logo PROVISOIRE (panda simple). Pour le remplacer, ne modifier que ce fichier :
  garder la classe pb-mark et l'attribut data-brand-mark (reflets.js relance
  l'animation au survol). Couleurs : classes pb-* de pilotage.css, jetons du
  bloc marque (aucune couleur en dur ici).
  Le nom et le slogan viennent de marque.ejs et slogan.ejs (variables brandName, brandTagline).
%>
<svg class="pb-mark" data-brand-mark viewBox="0 0 48 48" width="44" height="44" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="pb-neon" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" class="pb-s-1"/>
      <stop offset="0.5" class="pb-s-2"/>
      <stop offset="1" class="pb-s-3"/>
    </linearGradient>
  </defs>
  <circle class="pb-rim" cx="24" cy="26" r="20.5" stroke="url(#pb-neon)"/>
  <g class="pb-ears">
    <circle class="pb-ear pb-ear--l" cx="11.5" cy="12.5" r="6.5" stroke="url(#pb-neon)"/>
    <circle class="pb-ear pb-ear--r" cx="36.5" cy="12.5" r="6.5" stroke="url(#pb-neon)"/>
  </g>
  <circle class="pb-head" cx="24" cy="26" r="16.5"/>
  <ellipse class="pb-black" cx="17.6" cy="25.2" rx="4.3" ry="5.6" transform="rotate(28 17.6 25.2)"/>
  <ellipse class="pb-black" cx="30.4" cy="25.2" rx="4.3" ry="5.6" transform="rotate(-28 30.4 25.2)"/>
  <circle class="pb-eye" cx="18.3" cy="24.4" r="1.6"/>
  <circle class="pb-eye" cx="29.7" cy="24.4" r="1.6"/>
  <circle class="pb-glint" cx="18.8" cy="23.8" r="0.6"/>
  <circle class="pb-glint" cx="30.2" cy="23.8" r="0.6"/>
  <ellipse class="pb-black" cx="24" cy="31.6" rx="2.5" ry="1.7"/>
  <path class="pb-mouth" d="M24 33.2 q-1.4 2.1 -3.2 1.1 M24 33.2 q1.4 2.1 3.2 1.1"/>
  <path class="pb-shine" d="M12.2 20.5 A13 13 0 0 1 20.5 11.6" stroke="url(#pb-neon)"/>
</svg>
<span class="brand-name"><span class="foil"><%= include('marque') %></span><small><%= include('slogan') %></small></span>
