<%#
  Shared header of /espace and /admin/console.
  locals: sousTitre, email, badge, salut, titre, intro, cta {href,label}, nav [{id,label,emoji,count}], vue, base
  The title is set in the animated accent foil (.foil); a leading or trailing
  emoji is kept outside the foil so it stays in colour.
%>
<%
  const emojiRun = '(?:\\p{Extended_Pictographic}|\\uFE0F|\\u200D)+';
  let titreTexte = String(titre || '');
  let emojiAvant = '';
  let emojiApres = '';
  const avant = new RegExp('^(' + emojiRun + ')\\s*', 'u').exec(titreTexte);
  if (avant) { emojiAvant = avant[1]; titreTexte = titreTexte.slice(avant[0].length); }
  const apres = new RegExp('\\s*(' + emojiRun + ')$', 'u').exec(titreTexte);
  if (apres) { emojiApres = apres[1]; titreTexte = titreTexte.slice(0, apres.index); }
%>
<a class="skip" href="#contenu">Aller au contenu</a>
<header class="topbar">
  <div class="wrap topbar-row">
    <a class="brand" href="<%= base %>">
      <svg class="pb-mark" data-pandora-mark viewBox="0 0 48 48" width="44" height="44" aria-hidden="true" focusable="false">
        <%# Couleurs : classes pb-* de pilotage.css, branchées sur --accent et --accent-2 (aucune couleur en dur). %>
        <defs>
          <linearGradient id="pb-body" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" class="pb-s-light"/>
            <stop offset="0.45" class="pb-s-mid"/>
            <stop offset="1" class="pb-s-deep"/>
          </linearGradient>
          <linearGradient id="pb-top" x1="0" y1="0" x2="1" y2="0.6">
            <stop offset="0" class="pb-s-light"/>
            <stop offset="0.55" class="pb-s-mid"/>
            <stop offset="1" class="pb-s-deep"/>
          </linearGradient>
          <linearGradient id="pb-shine" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" class="pb-s-shine" stop-opacity="0"/>
            <stop offset="0.5" class="pb-s-shine" stop-opacity="0.7"/>
            <stop offset="1" class="pb-s-shine" stop-opacity="0"/>
          </linearGradient>
          <radialGradient id="pb-halo" cx="0.5" cy="0.6" r="0.5">
            <stop offset="0" class="pb-s-glow" stop-opacity="0.9"/>
            <stop offset="1" class="pb-s-glow" stop-opacity="0"/>
          </radialGradient>
          <clipPath id="pb-clip"><rect x="9" y="23" width="30" height="19" rx="2.5"/></clipPath>
        </defs>
        <ellipse class="pb-glow" cx="24" cy="21" rx="15" ry="9" fill="url(#pb-halo)"/>
        <rect x="9" y="23" width="30" height="19" rx="2.5" fill="url(#pb-body)"/>
        <g clip-path="url(#pb-clip)">
          <rect class="pb-band" x="9" y="27.5" width="30" height="1.6"/>
          <rect class="pb-band" x="9" y="37" width="30" height="1.2"/>
          <rect class="pb-sheen" x="10" y="20" width="7" height="26" fill="url(#pb-shine)"/>
        </g>
        <rect class="pb-edge" x="9" y="23" width="30" height="19" rx="2.5"/>
        <circle class="pb-lock" cx="24" cy="32.4" r="1.9"/>
        <path class="pb-lock" d="M23.2 33.4 h1.6 l0.5 3.4 h-2.6 Z"/>
        <g class="pb-lid">
          <path d="M10.5 17.5 Q24 9.5 37.5 17.5 Z" fill="url(#pb-top)"/>
          <rect class="pb-edge-fill" x="7" y="17" width="34" height="5.5" rx="2" fill="url(#pb-top)"/>
          <circle class="pb-knob" cx="24" cy="13.6" r="1.5"/>
        </g>
        <path class="pb-spark" d="M33 0.5 L34.5 6 L40 7.5 L34.5 9 L33 14.5 L31.5 9 L26 7.5 L31.5 6 Z"/>
      </svg>
      <span class="brand-name"><span class="foil">Pandora</span><small><%= sousTitre %></small></span>
    </a>
    <div class="topbar-actions">
      <% if (email) { %><span class="who"><%= email %><% if (badge) { %> · <%= badge %><% } %></span><% } %>
      <button type="button" class="icon-btn" data-theme-toggle hidden aria-label="Changer de thème">🌙</button>
      <a class="topbar-link topbar-link--site" href="/">Voir le site</a>
      <% if (email) { %><a class="topbar-link" href="/login" data-logout>Déconnexion</a><% } %>
    </div>
  </div>
  <div class="wrap hero">
    <div>
      <p class="greet"><%= salut %></p>
      <h1><% if (emojiAvant) { %><span class="hero-emoji"><%= emojiAvant %></span><% } %><span class="foil"><%= titreTexte %></span><% if (emojiApres) { %> <span class="hero-emoji"><%= emojiApres %></span><% } %></h1>
      <% if (intro) { %><p class="intro"><%= intro %></p><% } %>
    </div>
    <% if (cta) { %><a class="btn btn--accent" href="<%= cta.href %>"><%= cta.label %></a><% } %>
  </div>
  <% if (nav && nav.length) { %>
  <nav class="wrap tabs" aria-label="Sections">
    <% nav.forEach(function (n) { %>
    <a href="<%= base %>?vue=<%= n.id %>"<% if (vue === n.id) { %> aria-current="page"<% } %>><span aria-hidden="true"><%= n.emoji %></span><%= n.label %><% if (n.count) { %><span class="count"><%= n.count %></span><% } %></a>
    <% }) %>
  </nav>
  <% } %>
</header>
