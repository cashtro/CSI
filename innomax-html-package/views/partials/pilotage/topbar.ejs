<%#
  Shared header of /espace and /admin/console.
  locals: sousTitre, email, badge, salut, titre, intro, cta {href,label}, nav [{id,label,emoji,count}], vue, base
  Logotype : variable EJS brandName (« Pandora » par défaut). Pour renommer la
  marque, la définir une fois pour toute l'app (app.locals.brandName = '…') ou
  la passer à res.render ; head.ejs (titre d'onglet) et ce fichier la lisent.
  The title is set in the animated accent foil (.foil); a leading or trailing
  emoji is kept outside the foil so it stays in colour.
%>
<%
  const nomMarque = (typeof brandName === 'string' && brandName.trim()) || 'Pandora';
  const emojiRun = '(?:\\p{Extended_Pictographic}|\\uFE0F|\\u200D)+';
  let titreTexte = String(titre || '');
  let emojiAvant = '';
  let emojiApres = '';
  const avant = new RegExp('^(' + emojiRun + ')\\s*', 'u').exec(titreTexte);
  if (avant) { emojiAvant = avant[1]; titreTexte = titreTexte.slice(avant[0].length); }
  const apres = new RegExp('\\s*(' + emojiRun + ')$', 'u').exec(titreTexte);
  if (apres) { emojiApres = apres[1]; titreTexte = titreTexte.slice(0, apres.index); }
%>
<a class="skip" href="#contenu">Aller au contenu</a>
<header class="topbar">
  <div class="wrap topbar-row">
    <a class="brand" href="<%= base %>">
      <svg class="pb-mark" data-pandora-mark viewBox="0 0 48 48" width="44" height="44" aria-hidden="true" focusable="false">
        <%# Boîte ouverte, lumière holographique. Couleurs : classes pb-* de pilotage.css (jetons --accent … --accent-4). %>
        <defs>
          <linearGradient id="pb-holo" x1="0" y1="0" x2="16" y2="0" gradientUnits="userSpaceOnUse" spreadMethod="repeat">
            <stop offset="0" class="pb-s-1"/>
            <stop offset="0.25" class="pb-s-2"/>
            <stop offset="0.5" class="pb-s-3"/>
            <stop offset="0.75" class="pb-s-4"/>
            <stop offset="1" class="pb-s-1"/>
          </linearGradient>
          <linearGradient id="pb-fade-g" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0" stop-color="white" stop-opacity="0.95"/>
            <stop offset="1" stop-color="white" stop-opacity="0"/>
          </linearGradient>
          <mask id="pb-fade"><rect x="0" y="0" width="48" height="24" fill="url(#pb-fade-g)"/></mask>
          <clipPath id="pb-beam"><path d="M11 24 L37 24 L46 1 L2 1 Z"/></clipPath>
        </defs>
        <g class="pb-glow" clip-path="url(#pb-beam)" mask="url(#pb-fade)">
          <rect class="pb-holo-run" x="-16" y="0" width="80" height="24" fill="url(#pb-holo)"/>
        </g>
        <rect class="pb-body" x="9" y="23" width="30" height="19" rx="3"/>
        <rect x="9" y="27.5" width="30" height="1.4" fill="url(#pb-holo)"/>
        <rect class="pb-edge" x="9" y="23" width="30" height="19" rx="3" stroke="url(#pb-holo)"/>
        <circle class="pb-lock" cx="24" cy="33" r="1.8"/>
        <path class="pb-lock" d="M23.2 34 h1.6 l0.5 3.2 h-2.6 Z"/>
        <g class="pb-lid">
          <rect class="pb-body" x="7" y="17.5" width="34" height="5" rx="2"/>
          <rect class="pb-edge" x="7" y="17.5" width="34" height="5" rx="2" stroke="url(#pb-holo)"/>
        </g>
        <path class="pb-spark" d="M30 0.5 L31.5 6 L37 7.5 L31.5 9 L30 14.5 L28.5 9 L23 7.5 L28.5 6 Z" fill="url(#pb-holo)"/>
      </svg>
      <span class="brand-name"><span class="foil"><%= nomMarque %></span><small><%= sousTitre %></small></span>
    </a>
    <div class="topbar-actions">
      <% if (email) { %><span class="who"><%= email %><% if (badge) { %> · <%= badge %><% } %></span><% } %>
      <button type="button" class="icon-btn" data-theme-toggle hidden aria-label="Changer de thème">🌙</button>
      <a class="topbar-link topbar-link--site" href="/">Voir le site</a>
      <% if (email) { %><a class="topbar-link" href="/login" data-logout>Déconnexion</a><% } %>
    </div>
  </div>
  <div class="wrap hero">
    <div>
      <p class="greet"><%= salut %></p>
      <h1><% if (emojiAvant) { %><span class="hero-emoji"><%= emojiAvant %></span><% } %><span class="foil"><%= titreTexte %></span><% if (emojiApres) { %> <span class="hero-emoji"><%= emojiApres %></span><% } %></h1>
      <% if (intro) { %><p class="intro"><%= intro %></p><% } %>
    </div>
    <% if (cta) { %><a class="btn btn--accent" href="<%= cta.href %>"><%= cta.label %></a><% } %>
  </div>
  <% if (nav && nav.length) { %>
  <nav class="wrap tabs" aria-label="Sections">
    <% nav.forEach(function (n) { %>
    <a href="<%= base %>?vue=<%= n.id %>"<% if (vue === n.id) { %> aria-current="page"<% } %>><span aria-hidden="true"><%= n.emoji %></span><%= n.label %><% if (n.count) { %><span class="count"><%= n.count %></span><% } %></a>
    <% }) %>
  </nav>
  <% } %>
</header>
