<%#
  Shared header of /espace and /admin/console.
  locals: sousTitre, email, badge, salut, titre, intro, cta {href,label}, nav [{id,label,emoji,count}], vue, base
  Logo : partial logo.ejs (panda provisoire, remplaçable seul). Nom et slogan :
  marque.ejs et slogan.ejs, seules sources (variables EJS brandName et
  brandTagline, à définir une fois via app.locals ou res.render).
  sousTitre (zone : « Espace entreprise », « Console de pilotage ») s'affiche en pastille.
  The title is set in the animated accent foil (.foil); a leading or trailing
  emoji is kept outside the foil so it stays in colour.
%>
<%
  const emojiRun = '(?:\\p{Extended_Pictographic}|\\uFE0F|\\u200D)+';
  let titreTexte = String(titre || '');
  let emojiAvant = '';
  let emojiApres = '';
  const avant = new RegExp('^(' + emojiRun + ')\\s*', 'u').exec(titreTexte);
  if (avant) { emojiAvant = avant[1]; titreTexte = titreTexte.slice(avant[0].length); }
  const apres = new RegExp('\\s*(' + emojiRun + ')$', 'u').exec(titreTexte);
  if (apres) { emojiApres = apres[1]; titreTexte = titreTexte.slice(0, apres.index); }
%>
<a class="skip" href="#contenu">Aller au contenu</a>
<header class="topbar">
  <div class="wrap topbar-row">
    <a class="brand" href="<%= base %>">
      <%- include('logo') %>
    </a>
    <div class="topbar-actions">
      <% if (sousTitre) { %><span class="zone-pill"><%= sousTitre %></span><% } %>
      <% if (email) { %><span class="who"><%= email %><% if (badge) { %> · <%= badge %><% } %></span><% } %>
      <button type="button" class="icon-btn" data-theme-toggle hidden aria-label="Changer de thème">🌙</button>
      <a class="topbar-link topbar-link--site" href="/">Voir le site</a>
      <% if (email) { %><a class="topbar-link" href="/login" data-logout>Déconnexion</a><% } %>
    </div>
  </div>
  <div class="wrap hero">
    <div>
      <p class="greet"><%= salut %></p>
      <h1><% if (emojiAvant) { %><span class="hero-emoji"><%= emojiAvant %></span><% } %><span class="foil"><%= titreTexte %></span><% if (emojiApres) { %> <span class="hero-emoji"><%= emojiApres %></span><% } %></h1>
      <% if (intro) { %><p class="intro"><%= intro %></p><% } %>
    </div>
    <% if (cta) { %><a class="btn btn--accent" href="<%= cta.href %>"><%= cta.label %></a><% } %>
  </div>
  <% if (nav && nav.length) { %>
  <nav class="wrap tabs" aria-label="Sections">
    <% nav.forEach(function (n) { %>
    <a href="<%= base %>?vue=<%= n.id %>"<% if (vue === n.id) { %> aria-current="page"<% } %>><span aria-hidden="true"><%= n.emoji %></span><%= n.label %><% if (n.count) { %><span class="count"><%= n.count %></span><% } %></a>
    <% }) %>
  </nav>
  <% } %>
</header>
