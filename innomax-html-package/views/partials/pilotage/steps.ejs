<% const ici = Number(m.etape || 0); %>
<ol class="steps" aria-label="Avancement : étape <%= ici + 1 %> sur <%= etapes.length %>">
  <% etapes.forEach(function (nom, i) { %>
  <li class="<%= i < ici ? 'is-done' : (i === ici ? 'is-current' : '') %>"<% if (i === ici) { %> aria-current="step"<% } %>>
    <span class="dot" aria-hidden="true"><%= fmt.etapeEmoji[i] %></span><span class="name"><%= nom %></span>
  </li>
  <% }) %>
</ol>
<p class="steps-label"><span aria-hidden="true"><%= fmt.etapeEmoji[ici] %></span> Étape <span class="num"><%= ici + 1 %>/<%= etapes.length %></span> · <%= etapes[ici] || '' %></p>
