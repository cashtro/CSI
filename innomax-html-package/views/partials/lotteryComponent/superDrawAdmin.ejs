<!-- Formulaire pour ajouter une nouvelle loterie -->
<div>
    <h2>Ajouter une nouvelle loterie</h2>
    <form action="/ajouter-loterie" method="POST" enctype="multipart/form-data">
        <div class="form-group">
            <label for="image">Choisir une photo :</label>
            <input type="file" id="image" name="image" accept="image/*" required>
        </div>
        
        <div class="form-group">
            <label for="nomProduit">Nom du produit :</label>
            <input type="text" id="nomProduit" name="nomProduit" required>
        </div>
        
        <div class="form-group">
            <label for="description">Description du produit :</label>
            <textarea id="description" name="description" rows="4" required></textarea>
        </div>
        
        <div class="form-group">
            <label for="dateLotto">Date de la loterie :</label>
            <input type="date" id="dateLotto" name="dateLotto" required>
        </div>
        
        <button type="submit" class="btn btn-primary">Ajouter la loterie</button>
    </form>
</div>

