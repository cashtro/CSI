<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lottery Cards Layout</title>
    <link rel="stylesheet" href="assets/css/lottery.css">
    <link rel="stylesheet" href="assets/css/lotteryCard.css">

</head>
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Arial', sans-serif;
    }
 
    body {
        padding: 0;
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
    }
    
   
 
    .banner {
        width: 100%;
        margin-bottom: 30px;
        text-align: center;
        padding: 20px 0;
        background-color: transparent !important;
        border-radius: 10px;
        overflow: hidden;
    }
 
    .banner-text {
        font-size: 60px;
        font-weight: bold;
        color: #E6C373;
        text-shadow: rgba(255, 215, 0, 0.4) 0px 0px 20.0431px, rgb(255, 73, 0) 0px 0px 24.7815px;
        letter-spacing: 2px;
        text-transform: uppercase;
        animation: glow 2s infinite alternate;
    }
 
    @keyframes glow {
        from {
            text-shadow: rgba(255, 215, 0, 0.4) 0px 0px 20.0431px, rgb(255, 73, 0) 0px 0px 24.7815px;
        }
        to {
            text-shadow: rgba(255, 215, 0, 0.6) 0px 0px 25px, rgb(255, 73, 0) 0px 0px 35px;
        }
    }
 

 
    /* Super Draw Title */
    .super-draw-title {
        position: relative;
        background: linear-gradient(to right, #E6C373, #ffd277, #E6C373);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-align: center;
        margin: 80px 0 60px;
        font-size: 68px;
        font-weight: 900;
        text-shadow: 0 0 10px rgba(255, 215, 0, 0.4);
        letter-spacing: 5px;
        text-transform: uppercase;
        padding-top: 20px;
        line-height: 1.2;
        z-index: 10;
        animation: float 4s ease-in-out infinite, neonPulse 1.5s ease-in-out infinite;
        transform-origin: center bottom;
        filter: drop-shadow(0 0 12px rgba(255, 215, 0, 0.3));
        transition: all 0.3s ease;
    }
    
    @keyframes float {
        0%, 100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-7.89533px);
        }
    }
    
    @keyframes neonPulse {
        from {
            text-shadow: rgba(255, 215, 0, 0.4) 0px 0px 20px, rgb(255, 73, 0) 0px 0px 24.7361px;
        }
        to {
            text-shadow: rgba(255, 215, 0, 0.6) 0px 0px 25px, rgb(255, 73, 0) 0px 0px 30px;
        }
    }


 
    .detail-item {
        display: flex;
        flex-direction: column;
    }
 
    .detail-label {
        font-size: 14px;
        color: #E6C373;
        margin-bottom: 8px;
        opacity: 0.9;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-shadow: rgba(255, 215, 0, 0.1) 0px 0px 5px;
    }
 
    .detail-value {
        font-size: 20px;
        color: #E6C373;
        font-weight: 600;
        text-shadow: rgba(255, 215, 0, 0.3) 0px 0px 15.0431px, rgba(255, 73, 0, 0.2) 0px 0px 14.7815px;
    }
 
    .entry-progress {
        height: 12px;
        background-color: #333333;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 15px;
        box-shadow: inset 0 2px 5px rgba(0,0,0,0.5);
    }
 
    .progress-bar {
        height: 100%;
        background: linear-gradient(90deg, #855e1b, #E6C373);
        box-shadow: 0 0 8px rgba(255, 215, 0, 0.7);
        animation: glow-bar 1.5s infinite alternate;
    }
 
    @keyframes glow-bar {
        from {
            box-shadow: 0 0 5px rgba(255, 215, 0, 0.5);
        }
        to {
            box-shadow: 0 0 15px rgba(255, 215, 0, 0.8);
        }
    }
 
    .entry-text {
        display: flex;
        justify-content: space-between;
        font-size: 16px;
        color: #E6C373;
        margin-bottom: 20px;
        text-shadow: rgba(255, 215, 0, 0.2) 0px 0px 8px;
    }
 
    .item-description-container {
        position: relative;
        margin-top: 20px;
        margin-bottom: 20px;
    }
 
    .item-description-toggle {
        display: flex;
        align-items: center;
        color: #E6C373;
        font-size: 16px;
        cursor: pointer;
        background: none;
        border: none;
        padding: 5px 0;
        transition: all 0.3s ease;
        text-shadow: rgba(255, 215, 0, 0.3) 0px 0px 10px;
    }
 
    .item-description-toggle:hover {
        text-shadow: rgba(255, 215, 0, 0.5) 0px 0px 15px;
    }
 
    .arrow-icon {
        display: inline-block;
        width: 20px;
        height: 20px;
        margin-right: 10px;
        transition: transform 0.3s ease;
        position: relative;
    }
 
    .arrow-icon::before,
    .arrow-icon::after {
        content: '';
        position: absolute;
        background-color: #E6C373;
        top: 50%;
        width: 10px;
        height: 2px;
        box-shadow: 0 0 5px rgba(255, 215, 0, 0.5);
    }
 
    .arrow-icon::before {
        left: 0;
        transform: translateY(-50%) rotate(45deg);
    }
 
    .arrow-icon::after {
        right: 0;
        transform: translateY(-50%) rotate(-45deg);
    }
 
    .rotate-arrow {
        transform: rotate(90deg);
    }
 
    .item-detailed-description {
        background-color: rgba(0, 0, 0, 0.8);
        border: 1px solid rgba(255, 215, 0, 0.3);
        border-radius: 8px;
        padding: 15px;
        margin-top: 10px;
        color: #E6C373;
        font-size: 14px;
        line-height: 1.6;
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        transition: all 0.5s ease;
        text-shadow: rgba(255, 215, 0, 0.2) 0px 0px 8px;
        position: relative;
    }
 
    .item-detailed-description.active {
        max-height: 200px;
        opacity: 1;
        margin-bottom: 15px;
        overflow-y: auto;
    }
 
    /* Style the scrollbar for the description */
    .item-detailed-description::-webkit-scrollbar {
        width: 5px;
    }
 
    .item-detailed-description::-webkit-scrollbar-track {
        background: rgba(0, 0, 0, 0.3);
        border-radius: 5px;
    }
 
    .item-detailed-description::-webkit-scrollbar-thumb {
        background: rgba(255, 215, 0, 0.5);
        border-radius: 5px;
    }

    
    /* Video Background */
    .video-background {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        z-index: 0 !important;
    }
    
    /* Ensure the content stays above the video */
    .content-wrapper {
        position: relative;
        z-index: 5 !important;
    }
    

    
    .redirect-info {
        text-align: center;
        color: #E6C373;
        font-size: 16px;
        margin-top: 15px;
        width: 80%;
        max-width: 740px;
        margin-left: auto;
        margin-right: auto;
        text-shadow: 0 0 5px rgba(255, 193, 7, 0.3);
    }
    
    /* Title container */
    .title-video-container {
        position: relative;
        height: 300px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 40px;
        z-index: 5;
        background-color: transparent !important;
    }
    
    
    
    
   
</style>

<body>
    <!-- Video Background -->
    <video class="video-background" autoplay loop muted playsinline>
        <source src="assets/mp4/black-luxury-background-with-gold-lines-2023-11-27-05-36-22-utc (1).mp4" type="video/mp4">
    </video>
    
    <div class="content-wrapper">
        

        <div class="lottery-container" id="lottery-container">
            <!-- Cards will be injected here -->
          </div>
        </div>
            
            
        <script type="application/json" id="lotteries-data"><%- JSON.stringify(lotteries).replace(/</g, '\\u003c') %></script>
        <script>
  // Keep window.lotteries as a JSON string: lotteryUserData.js calls JSON.parse(window.lotteries)
  window.lotteries = document.getElementById('lotteries-data').textContent;
</script>
    <script src="assets/js/lotteryUserData.js" defer></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const toggleButtons = document.querySelectorAll('.item-description-toggle');
           
            toggleButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const arrow = this.querySelector('.arrow-icon');
                    const description = this.nextElementSibling;
                   
                    arrow.classList.toggle('rotate-arrow');
                    description.classList.toggle('active');
                });
            });
        });
    </script>
</body>
</html>