                    <form id="searchForm" autocomplete="off">
                        <div class="search-container" style="position: relative !important;">
                            <input type="text" id="searchInput" placeholder="Search..." 
                                   class="search-field" 
                                   style="padding-right: 40px;">
                            <button type="submit" class="search-submit" 
                                    style="position: absolute; right: 0; top: 0; height: 100%; border: none; background: none;">
                                <i class="fas fa-search"></i>
                            </button>
                            <div id="searchSuggestions" 
                                 style="display: none; position: absolute; top: 100%; left: 0; right: 0; background: #010315; border: 1px solid #E6C373; z-index: 1000;"></div>
                        </div>
                    </form>
                    <script>
                        const routeMapping = {
                            'home': '/',
                            'tech': '/TechAI',
                            'marketing digital': '/marketing',
                            'nft': '/nft',
                            'education': '/education',
                            'lottery': '/luckydraw',
                            'portfolio': '/portfolio',
                            'contact': '/contact'
                        };
                        
                        document.getElementById('searchInput').addEventListener('input', function(e) {
                            const input = e.target.value.toLowerCase();
                            const suggestions = document.getElementById('searchSuggestions');
                            
                            suggestions.innerHTML = '';
                            suggestions.style.display = 'none';
                            
                            if(input.length > 1) {
                                const matches = Object.keys(routeMapping)
                                    .filter(key => key.includes(input))
                                    .sort((a, b) => a.indexOf(input) - b.indexOf(input));
                                
                                if(matches.length) {
                                    suggestions.style.display = 'block';
                                    matches.forEach(match => {
                                        const div = document.createElement('div');
                                        div.innerHTML = `
                                            <div style="padding: 10px; cursor: pointer; transition: background 0.3s;"
                                                 onmouseover="this.style.background='#1a1a2e'" 
                                                 onmouseout="this.style.background='transparent'"
                                                 onclick="window.location.href='${routeMapping[match]}'">
                                                <i class="fas fa-chevron-right" style="margin-right: 10px; color: #E6C373;"></i>
                                                ${match}
                                            </div>`;
                                        suggestions.appendChild(div);
                                    });
                                }
                            }
                        });
                        
                        document.getElementById('searchForm').addEventListener('submit', function(e) {
                            e.preventDefault();
                            const input = document.getElementById('searchInput').value.toLowerCase();
                            const match = Object.keys(routeMapping).find(key => key.includes(input));
                            window.location.href = match ? routeMapping[match] : '/';
                        });
                        </script>
