    <script>
        function showOrHide(id, show, displayType) {
            const el = document.getElementById(id);
            if (el) {
                el.style.display = show ? displayType : 'none';
            }
        }

        // Retry logic to ensure elements are present before running checkAuthAndShowButtons
        function waitForButtonsAndRun(fn, retries = 10) {
            const ids = [
                'regulardashboardbtn', 'regularlogoutbtn', 'regularloginbtn',
                'mobiledashboardbtn', 'mobilelogoutbtn', 'mobileloginbtn'
            ];
            const allPresent = ids.every(id => document.getElementById(id));
            if (allPresent) {
                fn();
            } else if (retries > 0) {
                setTimeout(() => waitForButtonsAndRun(fn, retries - 1), 100);
            }
        }

        async function checkAuthAndShowButtons() {
            let isLoggedIn = false;
            const token = sessionStorage.getItem('accessToken') || localStorage.getItem('accessToken');
            console.log('[DEBUG] Token found:', token);
            if (token) {
                try {
                    console.log('[DEBUG] Sending validateToken request...');
                    const response = await fetch('/api/auth/validateToken', {
                        method: 'GET',
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    console.log('[DEBUG] validateToken response status:', response.status);
                    if (response.ok) {
                        const data = await response.json();
                        console.log('[DEBUG] validateToken response JSON:', data);
                        isLoggedIn = data.success || data.valid || data.authenticated;
                    } else {
                        console.log('[DEBUG] validateToken response not ok, removing token');
                        sessionStorage.removeItem('accessToken');
                        localStorage.removeItem('accessToken');
                    }
                } catch (error) {
                    console.log('[DEBUG] validateToken fetch error:', error);
                    sessionStorage.removeItem('accessToken');
                    localStorage.removeItem('accessToken');
                }
            } else {
                console.log('[DEBUG] No token found');
            }

            // Desktop
            showOrHide('regulardashboardbtn', isLoggedIn, 'inline-flex');
            showOrHide('regularlogoutbtn', isLoggedIn, 'inline-flex');
            showOrHide('regularloginbtn', !isLoggedIn, 'inline-flex');
            // Mobile
            showOrHide('mobiledashboardbtn', isLoggedIn, 'block');
            showOrHide('mobilelogoutbtn', isLoggedIn, 'block');
            showOrHide('mobileloginbtn', !isLoggedIn, 'block');

            // Attach logout handlers
            if (isLoggedIn) {
                const regLogout = document.getElementById('regularlogoutbtn');
                if (regLogout) {
                    regLogout.onclick = handleLogout;
                }
                const mobLogout = document.getElementById('mobilelogoutbtn');
                if (mobLogout) {
                    mobLogout.onsubmit = function(e) { e.preventDefault(); handleLogout(); };
                }
            }
        }

        async function handleLogout() {
            const token = sessionStorage.getItem('accessToken') || localStorage.getItem('accessToken');
            try {
                await fetch('/api/auth/logout', {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}` },
                    credentials: 'include'
                });
            } catch (error) {
                // Ignore errors
            } finally {
                sessionStorage.clear();
                localStorage.clear();
                window.location.href = '/';
            }
        }


        document.addEventListener('DOMContentLoaded', function () {
            waitForButtonsAndRun(checkAuthAndShowButtons);
        });
        window.addEventListener('load', function () {
            waitForButtonsAndRun(checkAuthAndShowButtons);
        });
    </script>
