<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="
  default-src 'self'; 
  script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; 
  style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net;
  img-src 'self' data: https:; 
  font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net;
  connect-src 'self';
  frame-ancestors 'none';
  form-action 'self';
  base-uri 'self';
">

  <meta http-equiv="X-Frame-Options" content="DENY">
  <meta http-equiv="X-XSS-Protection" content="1; mode=block">
  <meta http-equiv="X-Content-Type-Options" content="nosniff">
  <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin">
  <meta http-equiv="Permissions-Policy" content="geolocation=(), microphone=(), camera=()">
  <meta http-equiv="Strict-Transport-Security" content="max-age=31536000; includeSubDomains">
  <title>Pandora Business Technology & Marketing </title>

  <link rel="shortcut icon" href="assets/img/logo/cropped-LogoPB512gold-1.webp" type="images/x-icon" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    :root {
      --dark-gold: #855e1b;
      --light-gold: #E6C373;
      --accent-gold: #D4AF37;
      --input-border: rgba(133, 94, 27, 0.3);
      --bg-gradient: linear-gradient(135deg, #000000, #000000);
      --card-bg: rgba(14, 14, 14, 0.98);
      --text-color: #333333;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: var(--bg-gradient);
      min-height: 100vh;
      font-family: 'Poppins', sans-serif;
      position: relative;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at 30% 50%, rgba(212, 175, 55, 0.06), transparent 60%),
                  radial-gradient(circle at 70% 20%, rgba(212, 175, 55, 0.06), transparent 60%);
      z-index: 0;
    }

    .container {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 40px 20px;
      gap: 80px;
      position: relative;
      z-index: 1;
    }

    .video-container {
      flex-shrink: 0;
      position: relative;
      margin-left: 80px;
      max-width: 600px;
      width: 60%;
      order: 2;
    }

    .video-container video {
    width: 100%;
    height: 620px;
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 0 30px rgba(212, 175, 55, 0.15);
}

    .login-card {
      background: var(--card-bg);
      border-radius: 24px;
      padding: 50px 40px;
      width: 100%;
      max-width: 520px;
      position: relative;
      box-shadow: 0 15px 50px rgba(0, 0, 0, 0.3), 
                  0 0 60px rgba(230, 195, 115, 0.2);
      flex-shrink: 0;
      overflow: hidden;
      order: 1;
    }

    .login-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 10px;
      height: 100%;
      background: linear-gradient(to bottom, var(--dark-gold), var(--light-gold));
      border-top-left-radius: 24px;
      border-bottom-left-radius: 24px;
    }

    .company-name {
      position: absolute;
      top: 20px;
      right: 20px;
      font-family: 'Cinzel', serif;
      color: var(--dark-gold);
      font-weight: 600;
      font-size: 20px;
      letter-spacing: 2px;
      z-index: 5;
    }

    .login-title {
      font-family: 'Cinzel', serif;
      color: var(--dark-gold);
      margin: 0 0 40px;
      text-align: center;
      position: relative;
      font-size: 32px;
      font-weight: 600;
      letter-spacing: 1px;
    }

    .login-title::after {
      content: '';
      position: absolute;
      bottom: -12px;
      left: 50%;
      transform: translateX(-50%);
      width: 80px;
      height: 3px;
      background: linear-gradient(to right, var(--dark-gold), var(--light-gold));
      border-radius: 3px;
    }

    .form-group {
      margin-bottom: 25px;
      position: relative;
    }

    .form-control {
      width: 100%;
      height: 54px;
      border: 2px solid var(--input-border);
      border-radius: 12px;
      padding: 0 20px;
      font-size: 16px;
      font-family: 'Poppins', sans-serif;
      transition: all 0.3s ease;
      background: rgba(255, 255, 255, 0.9);
      color: var(--text-color);
      outline: none;
    }

    .form-control:focus {
      border-color: var(--light-gold);
      box-shadow: 0 0 15px rgba(230, 195, 115, 0.25);
    }

    .form-control::placeholder {
      color: #999;
      font-weight: 300;
    }

    .password-toggle {
      position: absolute;
      right: 18px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--dark-gold);
      cursor: pointer;
      font-size: 18px;
      transition: all 0.2s ease;
    }

    .password-toggle:hover {
      color: var(--light-gold);
    }

    .options-section {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      color: var(--dark-gold);
      font-size: 14px;
    }

    .form-check {
      display: flex;
      align-items: center;
    }

    .form-check-input {
      width: 16px;
      height: 16px;
      margin-right: 8px;
      accent-color: var(--accent-gold);
      cursor: pointer;
    }

    .form-check-label {
      cursor: pointer;
      user-select: none;
    }

    .options-section a {
      color: var(--dark-gold);
      text-decoration: none;
      transition: all 0.2s ease;
      position: relative;
    }

    .options-section a:hover {
      color: var(--light-gold);
    }

    .options-section a::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 0;
      height: 1px;
      background: var(--light-gold);
      transition: width 0.3s ease;
    }

    .options-section a:hover::after {
      width: 100%;
    }

    .btn-login {
      width: 100%;
      height: 54px;
      border-radius: 12px;
      background: linear-gradient(45deg, var(--dark-gold), var(--light-gold));
      color: #fff;
      border: none;
      font-size: 16px;
      font-weight: 500;
      letter-spacing: 0.5px;
      cursor: pointer;
      font-family: 'Poppins', sans-serif;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(133, 94, 27, 0.3);
    }

    .btn-login:hover {
      transform: translateY(-3px);
      box-shadow: 0 6px 20px rgba(133, 94, 27, 0.4);
    }

    .btn-login:active {
      transform: translateY(-1px);
    }

    .divider {
      display: flex;
      align-items: center;
      margin: 30px 0;
      color: #999;
      font-size: 14px;
    }

    .divider::before,
    .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--input-border);
    }

    .divider span {
      padding: 0 15px;
    }

    .social-login {
      display: flex;
      gap: 20px;
      margin-bottom: 30px;
    }

    .social-btn {
      flex: 1;
      height: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid var(--input-border);
      border-radius: 12px;
      background: transparent;
      transition: all 0.3s ease;
      cursor: pointer;
    }

    .social-btn:hover {
      border-color: var(--light-gold);
      background: rgba(230, 195, 115, 0.05);
    }

    .social-btn img {
      height: 24px;
    }

    .signup-text {
      text-align: center;
      color: var(--dark-gold);
      font-size: 15px;
      margin-top: 5px;
    }

    .signup-text a {
      color: var(--light-gold);
      font-weight: 500;
      text-decoration: none;
      position: relative;
      transition: all 0.2s ease;
    }

    .signup-text a:hover {
      color: var(--dark-gold);
    }

    .signup-text a::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 0;
      height: 1px;
      background: var(--dark-gold);
      transition: width 0.3s ease;
    }

    .signup-text a:hover::after {
      width: 100%;
    }

    /* Responsive - Tablette */
    @media (max-width: 1024px) {
      .container {
        gap: 40px;
      }
      
      .video-container {
        width: 45%;
        margin-right: 0;
      }
      
      .login-card {
        max-width: 400px;
      }
    }

    /* Responsive - Mobile */
    @media (max-width: 768px) {
      .container {
        flex-direction: column;
        padding: 30px 15px;
        gap: 40px;
      }
      
      .video-container {
        width: 80%;
        max-width: 320px;
        margin-right: 0;
        order: 2;
      }
      
      .login-card {
        width: 100%;
        max-width: 400px;
        padding: 40px 25px;
        order: 1;
      }
      
      .login-title {
        font-size: 26px;
        margin-bottom: 30px;
      }
      
      .company-name {
        font-size: 16px;
        top: 15px;
        right: 15px;
      }
      
      .form-control {
        height: 50px;
      }
      
      .btn-login {
        height: 50px;
      }
    }

    /* Petits mobiles */
    @media (max-width: 480px) {
      .container {
        padding: 20px 10px;
      }
      
      .video-container {
        width: 100%;
        max-width: 280px;
      }
      
      .login-card {
        padding: 30px 20px;
        border-radius: 20px;
      }
      
      .options-section {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
      }
      
      .social-login {
        gap: 15px;
      }
    }

    /* Add these styles to your existing CSS */
    .verification-modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0,0,0,0.7);
      z-index: 1000;
    }

    .verification-content {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: var(--card-bg);
      padding: 50px 40px;
      border-radius: 24px;
      width: 90%;
      max-width: 520px;
      box-shadow: 0 15px 50px rgba(0, 0, 0, 0.3), 
                  0 0 60px rgba(230, 195, 115, 0.2);
      position: relative;
      overflow: hidden;
    }

    .verification-content::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 10px;
      height: 100%;
      background: linear-gradient(to bottom, var(--dark-gold), var(--light-gold));
      border-top-left-radius: 24px;
      border-bottom-left-radius: 24px;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .modal-header h2 {
      font-family: 'Cinzel', serif;
      color: var(--dark-gold);
      font-size: 24px;
      font-weight: 600;
      margin: 0;
    }

    .close-modal {
      color: var(--dark-gold);
      font-size: 28px;
      font-weight: bold;
      cursor: pointer;
      transition: color 0.3s ease;
    }

    .close-modal:hover {
      color: var(--light-gold);
    }

    .modal-body {
      color: var(--dark-gold);
      margin-bottom: 30px;
    }

    .modal-buttons {
      display: flex;
      gap: 1rem;
      justify-content: flex-end;
    }

    .btn-verify {
      background: linear-gradient(45deg, var(--dark-gold), var(--light-gold));
      color: #fff;
      border: none;
      padding: 12px 24px;
      border-radius: 12px;
      cursor: pointer;
      font-weight: 500;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(133, 94, 27, 0.3);
    }

    .btn-verify:hover {
      transform: translateY(-3px);
      box-shadow: 0 6px 20px rgba(133, 94, 27, 0.4);
    }

    .btn-cancel {
      background: rgba(255, 255, 255, 0.1);
      color: var(--dark-gold);
      border: 1px solid var(--input-border);
      padding: 12px 24px;
      border-radius: 12px;
      cursor: pointer;
      font-weight: 500;
      transition: all 0.3s ease;
    }

    .btn-cancel:hover {
      background: rgba(255, 255, 255, 0.15);
      transform: translateY(-3px);
    }

    @media (max-width: 768px) {
      .verification-content {
        padding: 40px 30px;
        width: 95%;
      }
      
      .modal-buttons {
        flex-direction: column;
        gap: 0.75rem;
      }
      
      .modal-buttons button {
        width: 100%;
      }
    }
  </style>
<style>
  /* Ajustements mobile */
  @media (max-width: 767px) {
    .container {
      display: flex;
      flex-direction: column;
    }

    .video-container {
      order: -1; /* Place la vidéo en première position */
      height: 10vh; /* Hauteur vidéo réduite */
      width: 100%;
      margin: 0 0 20px 0; /* Marge uniquement en bas */
    }

    .login-card {
      margin-top: 0; /* Supprime l'espace au-dessus du formulaire */
      width: 100%; /* Pleine largeur */
    }

    .video-container video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: none; /* Retire le décalage précédent */
    }
  }
</style>
  
  <script src="/assets/js/retour.js"></script>
</head>

<body>
  <div class="container">
    <div class="login-card">
      <div class="company-name">PANDORA</div>
      <h1 class="login-title">Sign Up</h1>
      
      <form id="signUpForm">
        <div class="form-group">
          <input type="text" name="username" class="form-control" placeholder="Username" required>
        </div>
        
        <div class="form-group">
          <input type="email" name="email" class="form-control" placeholder="Email Address" required>
        </div>
        
         <div class="form-group">
          <input type="password" name="password" class="form-control" placeholder="Password" id="password" required>
          <i class="bi bi-eye-slash password-toggle" onclick="togglePassword(this, 'password')" ></i>
        </div>
        <div class="form-group">
          <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm Password" id="confirmPassword" required>
          <i class="bi bi-eye-slash password-toggle" onclick="togglePassword(this, 'confirmPassword')"></i>
        </div>

        <div class="form-group">
          <input type="number" name="age" class="form-control" placeholder="Age" required>
        </div>

        <div class="options-section">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="termsAgree">
            <label class="form-check-label" for="termsAgree">I agree to terms & conditions</label>
          </div>
        </div>

        <button type="submit" class="btn-login">Sign Up</button>
      </form>

      <div class="divider">
        <span>or</span>
      </div>

      
      <div class="social-login">
        <button id="googleLogin" class="social-btn">
          <img src="assets/img/icon/05.webp" alt="Google">
        </button>
      </div>

      <p class="signup-text">
        Already have an account? <a href="/login">Login here</a>
      </p>
    </div>

    <div class="video-container">
      <video autoplay loop muted>
        <source src="assets/mp4/Pandora Brand- video intro.mp4" type="video/mp4">
        Votre navigateur ne supporte pas la lecture de vidéos.
      </video>
    </div>
  </div>

  <div id="googleAccountModal" class="verification-modal">
    <div class="verification-content">
      <div class="modal-header">
        <h2>Account Already Exists</h2>
        <span class="close-modal">&times;</span>
      </div>
      <div class="modal-body">
        <p id="googleAccountMessage"></p>
        <div class="modal-buttons">
          <button id="addPasswordBtn" class="btn-verify">Add Password</button>
          <button id="cancelAddPasswordBtn" class="btn-cancel">Cancel</button>
        </div>
      </div>
    </div>
  </div>



  <script type="module" src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js/dist/umd/supabase.js"></script>
  <script>
    // Pass to the module
    window.APP_URL = "<%= APP_URL %>";
    window.supabaseUrl = "<%= supabaseUrl %>";
    window.supabaseAnonKey = "<%= supabaseAnonKey %>";
   
  </script>
  <script type="module" src="assets/js/provider.js"></script>
  <script type="module" src="/assets/js/signup.js"></script>

  

  <script>
  document.addEventListener('DOMContentLoaded', function() {
    const signupForm = document.getElementById('signupForm');
    const googleAccountModal = document.getElementById('googleAccountModal');
    const googleAccountMessage = document.getElementById('googleAccountMessage');
    const addPasswordBtn = document.getElementById('addPasswordBtn');
    const cancelAddPasswordBtn = document.getElementById('cancelAddPasswordBtn');
    const closeModal = document.querySelector('#googleAccountModal .close-modal');

    // Handle form submission
    signupForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const formData = new FormData(signupForm);
      const data = Object.fromEntries(formData.entries());

      try {
        const response = await fetch('/api/auth/register', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data)
        });

        const result = await response.json();

        if (response.status === 409 && result.isGoogleUser) {
          // Show modal for Google account
          googleAccountMessage.textContent = result.message;
          googleAccountModal.style.display = 'block';
        } else if (!response.ok) {
          throw new Error(result.message || 'Registration failed');
        } else {
          // Success - redirect to login or show success message
          window.location.href = '/login?registered=true';
        }
      } catch (error) {
        console.error('Registration error:', error);
        // Show error message to user
        alert(error.message);
      }
    });

    // Handle add password button
    addPasswordBtn.addEventListener('click', async function() {
      const email = document.querySelector('input[name="email"]').value;
      
      try {
        const response = await fetch('/api/auth/add-password', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ email })
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.message || 'Failed to add password');
        }

        // Show success message and close modal
        alert(result.message);
        googleAccountModal.style.display = 'none';
        window.location.href = '/login';
      } catch (error) {
        console.error('Add password error:', error);
        alert(error.message);
      }
    });

    // Handle cancel button
    cancelAddPasswordBtn.addEventListener('click', function() {
      googleAccountModal.style.display = 'none';
    });

    // Handle close modal button
    closeModal.addEventListener('click', function() {
      googleAccountModal.style.display = 'none';
    });

    // Close modal when clicking outside
    window.addEventListener('click', function(event) {
      if (event.target === googleAccountModal) {
        googleAccountModal.style.display = 'none';
      }
    });
  });
  </script>
</body>
</html>