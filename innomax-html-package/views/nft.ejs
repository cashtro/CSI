/* CSS for Legends NFT Section */

/* General styles for Legends section */
.legends-section {
  position: relative;
  z-index: 1;
}

.section-main-title {
  font-family: "Monument Extended", sans-serif;
  font-size: 42px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 30px;
}

/* Legend Grid Layout */
.legend-grid {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 50px 30px;
  margin: 0 auto;
  max-width: 1400px;
  position: relative;
  z-index: 1;
}

/* NFT Legends Section Base Styles */
.legends-section-nft {
  background-color: #000 !important;
  padding: 60px 0 !important;
  margin-top: 70px !important;
  width: 100% !important;
}

.section-title-nft {
  text-align: center !important;
  color: white !important;
  margin-bottom: 20px !important;
  font-size: 36px !important;
  font-weight: 700 !important;
  margin-bottom: 10% !important;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7) !important;
}

.gold-accent-nft {
  color: #E6C373 !important;
}

/* Legend Grid Container */
.legend-grid-nft {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  padding: 50px 6% !important;
  background-size: cover !important;
  background-position: center !important;
  position: relative !important;
  overflow: hidden !important;
  margin-bottom: 50px !important;
}

.legend-grid-nft.reversed-nft {
  flex-direction: row-reverse !important;
}

/* Legend Media Container */
.legend-media-nft {
  flex: 0 0 45% !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
}

/* NFT Preview Video Container - Updated with zoom effect */
.legend-preview-nft {
  width: 90% !important;
  height: 450px !important; /* Fixed height for better control */
  border-radius: 10px !important;
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.5) !important;
  margin-bottom: 20px !important;
  object-fit: cover !important; /* Changed from 'contain' to 'cover' */
  object-position: center !important; /* Focus on the center of the video */
  transform: scale(1) !important; /* Zoom effect to focus on center */
  overflow: hidden !important;
}

/* Container for the preview to manage overflow */
.preview-container-nft {
  width: 90% !important;
  height: 350px !important;
  border-radius: 10px !important;
  overflow: hidden !important;
  position: relative !important;
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.5) !important;
}

/* NFT Button */
.btn-nft {
  padding: 10px 20px !important;
  background-color: #E6C373 !important;
  color: #000 !important;
  border: none !important;
  border-radius: 5px !important;
  font-weight: bold !important;
  cursor: pointer !important;
  transition: all 0.3s ease !important;
  margin-top: 15px !important;
}

.btn-nft:hover {
  background-color: #d4b05e !important;
  transform: translateY(-2px) !important;
}

/* Legend Info Container */
.legend-info-nft {
  flex: 0 0 55% !important;
  padding: 20px !important;
}

/* Legend Name Title */
.legend-name-nft {
  font-size: 28px !important; /* Smaller title */
  font-weight: 700 !important;
  color: #ffffff !important;
  margin-bottom: 15px !important;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8) !important;
}

/* Legend Biography Text */
.legend-bio-nft {
  font-size: 14px !important; /* Smaller text */
  line-height: 1.6 !important;
  color: #ffffff !important;
  margin-bottom: 20px !important;
  text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9) !important;
  max-width: 90% !important;
}

/* Documentary Section */
.documentary-section-nft {
  margin-top: 20px !important;
}

/* Documentary Title */
.doc-title-nft {
  font-size: 20px !important; /* Smaller documentary title */
  font-weight: 600 !important;
  color: #E6C373 !important;
  margin-bottom: 15px !important;
  text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8) !important;
}

/* YouTube Embed Container */
.yt-embed-container-nft {
  position: relative !important;
  padding-bottom: 44% !important;
  height: 0 !important;
  overflow: hidden !important;
  max-width: 90% !important;
  border-radius: 8px !important;
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.6) !important;
}

.yt-embed-container-nft iframe {
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: 100% !important;
  border: 0 !important;
}

