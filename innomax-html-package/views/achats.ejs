<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>Pandora Business Technology & Marketing</title>

    <%- include('partials/metaPixel', { pixelId: pixelId }) %>


    <link rel="shortcut icon" href="assets/img/logo/cropped-LogoPB512gold-1.png" type="images/x-icon" />

    <!-- css include -->
    <link rel="stylesheet" href="assets/css/normalize.css">




   <!-- ✅ Bundle global -->
<link rel="preload" href="assets/css/style.bundle.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="assets/css/style.bundle.min.css"></noscript>

<!-- ✅ Spécifiques -->

<link rel="stylesheet" href="assets/css/lotteryCard.css">
