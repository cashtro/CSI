                    background-color: #f9f9f9;
                    border-radius: 8px;
                    padding: 1rem;
                    margin-bottom: 1.5rem;
                ">
                    <p style="margin: 0; font-weight: 500;">Prix: <span id="enrollment-course-price"></span>$</p>
                </div>
                
                <form id="enrollment-form" class="enrollment-form">
                    <input type="hidden" id="enrollment-course-id" name="courseId">
                    
                    <div class="form-group" style="margin-bottom: 1.5rem;">
                        <label for="name" style="display: block; margin-bottom: 0.5rem; font-weight: 500; color: #555;">Nom Complet</label>
                        <input type="text" id="name" name="name" required style="
                            width: 100%;
                            padding: 0.75rem;
                            border: 1px solid #ddd;
                            border-radius: 4px;
                            font-size: 1rem;
                        ">
                    </div>
                    
                    <div class="form-group" style="margin-bottom: 1.5rem;">
                        <label for="email" style="display: block; margin-bottom: 0.5rem; font-weight: 500; color: #555;">Email</label>
                        <input type="email" id="email" name="email" required style="
                            width: 100%;
                            padding: 0.75rem;
                            border: 1px solid #ddd;
                            border-radius: 4px;
                            font-size: 1rem;
                        ">
                    </div>
                    
                    <div class="payment-section" style="margin-bottom: 1.5rem;">
                        <h4 style="margin-top: 0; margin-bottom: 1rem; font-size: 1.1rem; color: #555;">Méthode de Paiement</h4>
                        <div class="payment-options" style="display: flex; flex-direction: column; gap: 0.5rem; color : black ;">
                            <label style="display: flex; align-items: center; cursor: pointer;">
                                <input type="radio" name="payment_method" value="credit_card" required style="margin-right: 0.5rem;">
                                Carte de Crédit
                            </label>
                            <label style="display: flex; align-items: center; cursor: pointer;">
                                <input type="radio" name="payment_method" value="paypal" style="margin-right: 0.5rem;">
                                PayPal
                            </label>
                            <label style="display: flex; align-items: center; cursor: pointer;">
                                <input type="radio" name="payment_method" value="bank_transfer" style="margin-right: 0.5rem;">
                                Virement Bancaire
                            </label>
                        </div>
                    </div>
                    
                    <div class="form-actions" style="
                        display: flex;
                        justify-content: flex-end;
                        gap: 1rem;
                        margin-top: 2rem;
                    ">
                        <button type="button" class="cancel-btn" style="
                            padding: 0.75rem 1.5rem;
                            border-radius: 4px;
                            font-weight: 500;
                            cursor: pointer;
                            transition: all 0.2s;
                            background-color: #f1f1f1;
                            color: #333;
                            border: none;
                        ">Annuler</button>
                        <button type="submit" class="btn-enroll" style="
                            padding: 0.75rem 1.5rem;
                            border-radius: 4px;
                            font-weight: 500;
                            cursor: pointer;
                            transition: all 0.2s;
                            background-color: #4CAF50;
                            color: white;
                            border: none;
                        ">S'inscrire</button>
                    </div>
                </form>
            </div>
        `;
        
        document.body.appendChild(enrollmentModal);
        
        // Fermer le modal quand on clique sur Annuler
        enrollmentModal.querySelector('.cancel-btn').addEventListener('click', () => {
            enrollmentModal.style.display = 'none';
        });
        
        // Fermer le modal quand on clique en dehors
        enrollmentModal.addEventListener('click', (e) => {
            if (e.target === enrollmentModal) {
                enrollmentModal.style.display = 'none';
            }
        });
        
        // Gérer la soumission du formulaire
        enrollmentModal.querySelector('#enrollment-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = e.target;
            
            // Afficher un indicateur de chargement
            const submitBtn = form.querySelector('.btn-enroll');
            const originalBtnText = submitBtn.textContent;
            submitBtn.disabled = true;
            submitBtn.textContent = 'Traitement en cours...';
            
            try {
                // Récupérer les données du formulaire
                const formData = new FormData(form);
                const courseId = formData.get('courseId');
                
                // Ajouter l'ID de l'utilisateur (doit être disponible dans le localStorage)
                const userId = localStorage.getItem('userId');
                if (!userId) {
                    throw new Error('Vous devez être connecté pour vous inscrire à un cours');
                }
                formData.append('userId', userId);
                
                // Envoyer la requête à l'API
                const response = await fetch(`/api/course/${courseId}/enroll`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('accessToken')}`
                    },
                    body: formData
                });
                
                // Analyser la réponse
                const result = await response.json();
                
                if (!response.ok) {
                    throw new Error(result.error || 'Une erreur est survenue lors de l\'inscription');
                }
                
                // Vérifier si une redirection de paiement est nécessaire
                if (result.paymentUrl) {
                    // Rediriger vers la page de paiement
                    window.location.href = result.paymentUrl;
                } else {
                    // Afficher un message de succès
                    alert('Inscription réussie! Vous pouvez maintenant accéder au cours.');
                    enrollmentModal.style.display = 'none';
                    
                    // Rafraîchir la page si nécessaire
                    if (document.getElementById('courses-content').classList.contains('active')) {
                        displayCourses();
                    }
                }
            } catch (error) {
                console.error('Erreur lors de l\'inscription:', error);
                alert(`Erreur: ${error.message}`);
            } finally {
                // Réinitialiser le bouton
                submitBtn.disabled = false;
                submitBtn.textContent = originalBtnText;
            }
        });
    }
    
    // Mettre à jour les informations du cours dans le modal
    document.getElementById('enrollment-course-title').textContent = courseTitle;
    document.getElementById('enrollment-course-price').textContent = coursePrice;
    document.getElementById('enrollment-course-id').value = courseId;
    
    // Afficher le modal
    enrollmentModal.style.display = 'flex';
}


