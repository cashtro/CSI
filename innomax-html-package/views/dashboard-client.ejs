                    <div class="course-progress-bar" style="width: ${progressPercentage}%"></div>
                </div>
                <div class="content-card-actions">
                    <button class="view-course-btn">Voir détails</button>
                </div>
            `;
            coursesList.appendChild(courseCard);
            
            // Événement pour marquer comme terminé
            const markCompleteBtn = courseCard.querySelector('.mark-complete-btn');
            if (markCompleteBtn) {
                markCompleteBtn.addEventListener('click', async () => {
                    try {
                        const updatedProgress = await updateCourseProgress(course.id, 1);
                        
                        if (updatedProgress) {
                            // Mettre à jour visuellement la carte
                            const progressBar = courseCard.querySelector('.course-progress-bar');
                            progressBar.style.width = '100%';
                            
                            markCompleteBtn.outerHTML = `
                                <span class="course-completion-badge">Terminé</span>
                            `;
                            
                            alert('Félicitations ! Vous avez terminé ce cours.');
                        }
                    } catch (error) {
                        console.error('Erreur:', error);
                        alert('Une erreur est survenue. Veuillez réessayer.');
                    }
                });
            }
            
            // Événements existants pour la carte
            courseCard.addEventListener('click', function(e) {
                if (e.target.closest('.view-course-btn, .mark-complete-btn')) return;
                
                if (typeof openCourseSummaryModal === 'function') {
                    openCourseSummaryModal(course.id);
                }
            });
            
            const viewCourseBtn = courseCard.querySelector('.view-course-btn');
            viewCourseBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                if (typeof openCourseDetailsModal === 'function') {
                    openCourseDetailsModal(course.id);
                }
            });
        });

        // Ajouter les styles pour les badges
        addBadgeStyles();
    } catch (error) {
        coursesList.innerHTML = `<div class="error-loading">Erreur: ${error.message}</div>`;
    }
}

