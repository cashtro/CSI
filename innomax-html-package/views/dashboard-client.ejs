// Fonction pour récupérer les tirages depuis l'API
async function fetchDraws() {
    try {
        const response = await fetch('/api/lottery/lotteryData', {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('accessToken')}`
            }
        });
        
        if (!response.ok) {
            throw new Error('Erreur lors du chargement des tirages');
        }
        
        return await response.json();
    } catch (error) {
        console.error('Erreur:', error);
        return [];
    }
}

// Fonction pour afficher les tirages dans l'interface
async function displayDraws() {
    const drawsContent = document.querySelector('#draws-content .content-body');
    drawsContent.innerHTML = '<div class="loading-courses"><div class="spinner"></div><p>Chargement des tirages...</p></div>';

    try {
        const draws = await fetchDraws();
        
        if (draws.length === 0) {
            drawsContent.innerHTML = '<div class="no-courses">Aucun tirage disponible pour le moment</div>';
            return;
        }

        drawsContent.innerHTML = '';

        draws.forEach(draw => {
            // Formatter la date
            const drawDate = new Date(draw.lotteryTime);
            const formattedDate = drawDate.toLocaleDateString('fr-FR', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric'
            });
            
            const drawCard = document.createElement('div');
            drawCard.className = 'content-card';
            drawCard.dataset.drawId = draw.lotteryId;
            
            drawCard.innerHTML = `
                <div class="content-card-title">${draw.nomProduit || 'Tirage sans nom'}</div>
                <div class="content-card-value">${formattedDate}</div>
                <div class="content-card-desc">
                    <div>Prix du ticket: ${draw.entrieCost}$</div>
                    <div>Participants: ${draw.totalEntries || 0}</div>
                    <div class="lottery-image" style="margin-top: 15px; text-align: center;">
                        <img src="${draw.imageProduit}" alt="Image du tirage" 
                             style="max-width: 100%; height: auto; max-height: 150px; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
                    </div>
                </div>
                <div class="content-card-actions">
                    <button class="view-draw-btn">Voir détails</button>
                </div>
            `;
            
            drawsContent.appendChild(drawCard);
            
            // Ajouter les événements pour les boutons
            const viewBtn = drawCard.querySelector('.view-draw-btn');
            viewBtn.addEventListener('click', () => {
                window.location.href = `/Purchase-Lottery-Tickets?lotteryId=${draw.lotteryId}`;
            });
        });
    } catch (error) {
        drawsContent.innerHTML = `<div class="error-loading">Erreur: ${error.message}</div>`;
    }
}

