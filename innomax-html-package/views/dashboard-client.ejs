// Recherche interactive
const searchInput = document.querySelector('.search-input');
if (searchInput) {
    searchInput.addEventListener('input', function() {
        const searchTerm = this.value.toLowerCase();
        
        // Filtrer les éléments du menu
        menuItems.forEach(item => {
            const menuText = item.querySelector('.menu-text');
            if (menuText) {
                const text = menuText.textContent.toLowerCase();
                if (text.includes(searchTerm) || searchTerm === '') {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            }
        });
        
        // Si nous sommes sur la page des cours, filtrer également les cours
        const activeCoursesPage = document.getElementById('courses-content');
        if (activeCoursesPage && activeCoursesPage.classList.contains('active')) {
            const courseCards = activeCoursesPage.querySelectorAll('.content-card');
            courseCards.forEach(card => {
                const title = card.querySelector('.content-card-title').textContent.toLowerCase();
                const desc = card.querySelector('.content-card-desc').textContent.toLowerCase();
                
                if (title.includes(searchTerm) || desc.includes(searchTerm) || searchTerm === '') {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }
    });
}


