    }, 300);
}


// Fonction pour marquer une leçon comme terminée - version modifiée
async function marquerLeconCommeTerminee(courseId, lessonIndex) {
    try {
        // Obtenir l'ID de l'utilisateur actuel
        const validationResponse = await fetch(`/api/auth/validateToken`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`,
            }
        });

        if (!validationResponse.ok) {
            throw new Error('Token invalide ou expiré');
        }

        const { success, userid: studentId, error } = await validationResponse.json();
        
        if (!success || !studentId) {
            throw new Error(error || 'Échec de l\'authentification');
        }

        
        // Au lieu d'essayer de récupérer la progression existante (qui génère l'erreur 500),
        // nous allons directement mettre à jour avec une nouvelle valeur
        
        // Calculer la progression - une leçon est terminée sur le nombre total de leçons
        const lessonCount = document.querySelectorAll('.lecon-item').length;
        const lessonValue = 1 / lessonCount;
        
        // Calculer la nouvelle progression comme si la leçon actuelle était la seule complétée
        // Si vous préférez incrémenter au lieu de remplacer, vous pouvez modifier cette logique
        const newProgress = (parseInt(lessonIndex) + 1) / lessonCount;
        
        
        // Mettre à jour la progression du cours
        const updateResponse = await fetch(`/api/course/update-progress/${studentId}/${courseId}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${localStorage.getItem('accessToken')}`
            },
            body: JSON.stringify({ amount_completed: newProgress })
        });

        if (!updateResponse.ok) {
            const errorData = await updateResponse.json();
            throw new Error(errorData.error || 'Impossible de mettre à jour la progression');
        }
            
        return {
            success: true,
            newProgress,
            message: 'Leçon marquée comme terminée'
        };
    } catch (error) {
        console.error('Erreur:', error);
        return {
            success: false,
            message: error.message
        };
    }
}
// Fonction pour mettre à jour visuellement la leçon comme terminée
function mettreAJourLeconTerminee(lessonElement, isCompleted) {
    if (isCompleted) {
        lessonElement.classList.add('lecon-terminee');
        const statusBadge = document.createElement('span');
        statusBadge.className = 'statut-lecon terminee';
        statusBadge.textContent = 'Terminée';
        
        // Remplacer le bouton par le badge si nécessaire
        const existingButton = lessonElement.querySelector('.marquer-termine-btn');
        if (existingButton) {
            lessonElement.querySelector('.details-lecon').appendChild(statusBadge);
            existingButton.remove();
        }
    }
}


// Fonction pour récupérer la progression existante du cours sans provoquer d'erreur
async function recupererProgressionCours(studentId, courseId) {
    try {
        // Version sécurisée qui ne provoque pas d'erreur
        const response = await fetch(`/api/course/student-progress/${studentId}`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('accessToken')}`
            }
        });
        
        if (!response.ok) {
            return { amount_completed: 0 };
        }
        
        const allProgress = await response.json();
        const courseProgress = allProgress.find(p => p.course_id === courseId);
        
        if (courseProgress) {
            return { amount_completed: courseProgress.amount_completed || 0 };
        } else {
            return { amount_completed: 0 };
        }
    } catch (error) {
        return { amount_completed: 0 };
    }
}

// Fonction pour déterminer quelles leçons sont terminées en fonction de la progression
function determinerLeconsTerminees(progressionTotale, nombreLecons) {
    // Si progression est 0, aucune leçon n'est terminée
    if (progressionTotale <= 0) return [];
    
    // Si progression est 1 (100%), toutes les leçons sont terminées
    if (progressionTotale >= 1) {
        return Array.from({ length: nombreLecons }, (_, i) => i);
    }
    
    // Sinon, calculer le nombre de leçons terminées
    const leconsCompletes = Math.floor(progressionTotale * nombreLecons);
    return Array.from({ length: leconsCompletes }, (_, i) => i);
}

