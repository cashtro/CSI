// 1. Fonction améliorée pour récupérer les disponibilités
async function fetchAvailabilities() {
    try {
        const accessToken = localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken');

        const validationresponse = await fetch(`/api/auth/validateToken`, {
            headers: {
                'Authorization': `Bearer ${accessToken}`,
            }
        });

        const { success, userid, error } = await validationresponse.json();
        
        if (!userid) {
            const errorText = await validationresponse.text();
            console.error('Erreur API:', errorText);
            throw new Error(`Erreur lors du chargement de user: ${validationresponse.status}`);
        }
      
        
        // Utiliser la bonne URL d'API
        const response = await fetch(`/api/dispo/disponibilite?user_id=${userid}`, {
            method: 'GET',
            headers: {
                'Authorization': `Bearer ${accessToken}`,
                'Content-Type': 'application/json'
            }
        });
        
        
        if (!response.ok) {
            const errorText = await response.text();
            console.error('Erreur API:', errorText);
            throw new Error(`Erreur lors du chargement des disponibilités: ${response.status}`);
        }
        
        const data = await response.json();
        
        return Array.isArray(data) ? data : [];
    } catch (error) {
        console.error('Erreur complète lors de la récupération des disponibilités:', error);
        alert(`Erreur lors du chargement des disponibilités: ${error.message}`);
        return [];
    }
}

// 2. Fonction améliorée pour afficher les disponibilités
async function displayAvailabilities() {
    const availabilityList = document.getElementById('appointment-list');
    if (!availabilityList) {
        console.error("L'élément appointment-list est introuvable");
        return;
    }
    
    availabilityList.innerHTML = '<div class="loading-courses"><div class="spinner"></div><p>Chargement des disponibilités...</p></div>';

    try {
        // Récupérer les disponibilités
        const availabilities = await fetchAvailabilities();
        
        if (!Array.isArray(availabilities) || availabilities.length === 0) {
            availabilityList.innerHTML = '<div class="no-courses">Aucune disponibilité pour le moment</div>';
            return;
        }

        // Vider la liste avant d'ajouter les nouvelles cartes
        availabilityList.innerHTML = '';

        // Ajouter chaque disponibilité
        availabilities.forEach(availability => {
            try {
                const availabilityCard = document.createElement('div');
                availabilityCard.className = 'content-card';
                availabilityCard.dataset.availabilityId = availability.id;
                
                // Formater les dates
                const startTime = new Date(availability.start_time);
                const endTime = new Date(availability.end_time);
                
                const formattedStart = startTime.toLocaleString('fr-FR', { 
                    day: '2-digit', 
                    month: '2-digit', 
                    year: 'numeric', 
                    hour: '2-digit', 
                    minute: '2-digit' 
                });
                
                const formattedEnd = endTime.toLocaleTimeString('fr-FR', { 
                    hour: '2-digit', 
                    minute: '2-digit' 
                });
                
                // Calculer la durée
                const durationMs = endTime - startTime;
                const durationMinutes = Math.round(durationMs / (1000 * 60));
                
                availabilityCard.innerHTML = `
                    <div class="content-card-title">Disponibilité: ${formattedStart} - ${formattedEnd}</div>
                    <div class="content-card-value">Prix: ${availability.price || 0}$</div>
                    <div class="content-card-desc">
                        <div>Durée: ${durationMinutes} minutes</div>
                        <div>Taux de commission: ${availability.commission_rate || 0}%</div>
                    </div>
                    <div class="content-card-actions">
                        
                        <button class="delete-availability-btn"style="
            padding: 0.5rem 1rem;
            background-color: blue;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 500;
            transition: background-color 0.2s;
        ">Supprimer</button>
                    </div>
                `;
                availabilityList.appendChild(availabilityCard);
               
                
                // Événement pour supprimer
                const deleteBtn = availabilityCard.querySelector('.delete-availability-btn');
                deleteBtn.addEventListener('click', async () => {
                    if (confirm('Êtes-vous sûr de vouloir supprimer cette disponibilité ?')) {
                        try {
                            const response = await fetch(`/api/dispo/disponibilite/${availability.id}`, {
                                method: 'DELETE',
                                headers: {
                                    'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`
                                }
                            });
                            
                            if (response.ok) {
                                availabilityCard.remove();
                                alert('Disponibilité supprimée avec succès !');
                            } else {
                                const errorData = await response.json();
                                alert(`Erreur: ${errorData.message || 'Impossible de supprimer la disponibilité'}`);
                            }
                        } catch (error) {
                            console.error('Erreur:', error);
                            alert('Une erreur est survenue lors de la suppression de la disponibilité');
                        }
                    }
                });
            } catch (cardError) {
                console.error("Erreur lors de la création d'une carte de disponibilité:", cardError, availability);
            }
        });
    } catch (error) {
        console.error("Erreur complète lors de l'affichage des disponibilités:", error);
        availabilityList.innerHTML = `<div class="error-loading">Erreur: ${error.message}</div>`;
    }
}

// 3. Fonction améliorée pour créer une disponibilité
function openCreateAvailabilityModal() {
    let createModal = document.querySelector('.availability-create-modal');
    if (createModal) {
        document.body.removeChild(createModal);
    }
    
    createModal = document.createElement('div');
    createModal.classList.add('availability-create-modal');

    createModal.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.6);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    `;
    
    // Date et heure actuelles + 1 heure pour la fin
    const now = new Date();
    const start = new Date(now);
    start.setMinutes(Math.ceil(start.getMinutes() / 30) * 30); // Arrondir à la demi-heure supérieure
    
    const end = new Date(start);
    end.setHours(end.getHours() + 1); // Ajouter 1 heure par défaut
    
    // Formater pour datetime-local
    const formatDatetimeLocal = (date) => {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        const hours = String(date.getHours()).padStart(2, '0');
        const minutes = String(date.getMinutes()).padStart(2, '0');
        return `${year}-${month}-${day}T${hours}:${minutes}`;
    };
    
    createModal.innerHTML = `
        <div class="modal-content" style="
            background-color: white;
            border-radius: 8px;
            padding: 2rem;
            width: 90%;
            max-width: 500px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        ">
            <h3 style="margin-top: 0; margin-bottom: 1.5rem; color: #333;">Create a new availability</h3>
            
            <form id="create-availability-form" class="create-form">
                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label for="create-start-datetime" style="display: block; margin-bottom: 0.5rem; font-weight: 500; color: black;">Start date and time </label>
                    <input type="datetime-local" id="create-start-datetime" name="start_time" required value="${formatDatetimeLocal(start)}" style="
                        width: 100%;
                        padding: 0.75rem;
                        border: 1px solid #ddd;
                        border-radius: 4px;
                        font-size: 1rem;
                        
                    ">
                </div>
                
                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label for="create-end-datetime" style="display: block; margin-bottom: 0.5rem; font-weight: 500; color: black;"> End date and time</label>
                    <input type="datetime-local" id="create-end-datetime" name="end_time" required value="${formatDatetimeLocal(end)}" style="
                        width: 100%;
                        padding: 0.75rem;
                        border: 1px solid #ddd;
                        border-radius: 4px;
                        font-size: 1rem;
                    ">
                </div>
                
                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label for="create-price" style="display: block; margin-bottom: 0.5rem; font-weight: 500; color: black;">Price ($)</label>
                    <input type="number" id="create-price" name="price" min="0" step="0.01" value="30" required style="
                        width: 100%;
                        padding: 0.75rem;
                        border: 1px solid #ddd;
                        border-radius: 4px;
                        font-size: 1rem;
                    ">
                </div>
                
                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label for="create-commission-rate" style="display: block; margin-bottom: 0.5rem; font-weight: 500; color: black;">Commission rate (%)</label>
                    <input type="number" id="create-commission-rate" name="commission_rate" min="0" max="100" step="0.1" value="10" style="
                        width: 100%;
                        padding: 0.75rem;
                        border: 1px solid #ddd;
                        border-radius: 4px;
                        font-size: 1rem;
                    ">
                </div>
                
                <div class="form-actions" style="
                    display: flex;
                    justify-content: flex-end;
                    gap: 1rem;
                    margin-top: 2rem;
                ">
                    <button type="button" class="cancel-btn" style="
                        padding: 0.75rem 1.5rem;
                        background-color: #f1f1f1;
                        color: #333;
                        border: none;
                        border-radius: 4px;
                        cursor: pointer;
                        font-weight: 500;
                    ">Cancel</button>
                    <button type="submit" class="submit-btn" style="
                        padding: 0.75rem 1.5rem;
                        background-color: #4CAF50;
                        color: white;
                        border: none;
                        border-radius: 4px;
                        cursor: pointer;
                        font-weight: 500;
                    ">Create</button>
                </div>
            </form>
        </div>
    `;
    
    document.body.appendChild(createModal);
    
    // Fermer le modal
    createModal.querySelector('.cancel-btn').addEventListener('click', () => {
        document.body.removeChild(createModal);
    });
    
    // Fermer en cliquant en dehors
    createModal.addEventListener('click', (e) => {
        if (e.target === createModal) {
            document.body.removeChild(createModal);
        }
    });
    
    // Gérer la soumission du formulaire
    createModal.querySelector('#create-availability-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;
        
        try {
            const startDatetime = form.querySelector('#create-start-datetime').value;
            const endDatetime = form.querySelector('#create-end-datetime').value;
            const price = form.querySelector('#create-price').value;
            const commissionRate = form.querySelector('#create-commission-rate').value;
            
            // Vérifier que la date de fin est après la date de début
            const startDate = new Date(startDatetime);
            const endDate = new Date(endDatetime);
            
            if (endDate <= startDate) {
                alert('La date de fin doit être après la date de début');
                return;
            }
            
            // Récupérer le token d'authentification de différentes sources possibles
            const accessToken = localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken');
            
            /*
                start_time: startDatetime,
                end_time: endDatetime,
                price,
                commission_rate: commissionRate
            });*/
            
            // Envoyer la requête pour créer une disponibilité
            const response = await fetch('/api/dispo/disponibilite', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${accessToken}`
                },
                body: JSON.stringify({
                    start_time: startDatetime,
                    end_time: endDatetime,
                    price,
                    commission_rate: commissionRate
                })
            });
            
            
            const result = await response.json();
            
            if (response.ok) {
                alert('Disponibilité créée avec succès!');
                document.body.removeChild(createModal);
                
                // Actualiser immédiatement la liste des disponibilités
                await displayAvailabilities();
            } else {
                if (response.status === 401) {
                    alert('Session expirée - Veuillez vous reconnecter');
                    localStorage.removeItem('accessToken');
                    sessionStorage.removeItem('accessToken');
                    window.location.href = '/login';
                } else {
                    alert(`Erreur: ${result.error || 'Impossible de créer la disponibilité'}`);
                }
            }
        } catch (error) {
            console.error('Erreur complète lors de la création:', error);
            alert(`Une erreur est survenue lors de la création de la disponibilité: ${error.message}`);
        }
    });
}

