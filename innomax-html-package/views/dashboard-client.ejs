                        font-weight: 500;
                    ">Annuler</button>
                    <button type="submit" class="submit-btn" style="
                        padding: 0.75rem 1.5rem;
                        background-color: #4CAF50;
                        color: white;
                        border: none;
                        border-radius: 4px;
                        cursor: pointer;
                        font-weight: 500;
                    ">Réserver</button>
                </div>
            </form>
        </div>
    `;
    
    document.body.appendChild(createModal);
    
    // Fermer le modal
    createModal.querySelector('.cancel-btn').addEventListener('click', () => {
        document.body.removeChild(createModal);
    });
    
    // Fermer en cliquant en dehors
    createModal.addEventListener('click', (e) => {
        if (e.target === createModal) {
            document.body.removeChild(createModal);
        }
    });
    
    // Charger les disponibilités
    fetchDisponibilites();
    
    // Gérer le changement de disponibilité sélectionnée
    const disponibiliteSelect = document.getElementById('disponibilite_id');
    disponibiliteSelect.addEventListener('change', function() {
        const selectedId = this.value;
        if (selectedId) {
            fetchDisponibiliteDetails(selectedId);
        } else {
            document.getElementById('disponibilite-details').style.display = 'none';
        }
    });
    
    // Gérer la soumission du formulaire
    createModal.querySelector('#create-appointment-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        try {
            const disponibilite_id = document.getElementById('disponibilite_id').value;
            
            if (!disponibilite_id) {
                alert('Veuillez sélectionner une disponibilité');
                return;
            }
            
            // Données pour l'API handleRDVPayment
            const appointmentData = {
                disponibilite_id,
                id_eleve: localStorage.getItem('userId')
            };
            
            
            // Envoyer la demande de rendez-vous
            const response = await fetch('/api/rdv/create', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${localStorage.getItem('accessToken')}`
                },
                body: JSON.stringify(appointmentData)
            });
            
            const result = await response.json();
            
            if (response.ok && result.stripeSession && result.stripeSession.url) {
                // Rediriger vers la page de paiement Stripe
                window.location.href = result.stripeSession.url;
            } else if (response.ok) {
                // Si le rendez-vous a été créé sans redirection Stripe
                alert('Rendez-vous créé avec succès!');
                document.body.removeChild(createModal);
                displayAppointments();
            } else {
                // En cas d'erreur
                alert(`Erreur: ${result.message || 'Impossible de créer le rendez-vous'}`);
            }
        } catch (error) {
            console.error('Erreur complète:', error);
            alert('Une erreur est survenue lors de la création du rendez-vous');
        }
    });
}

// Fonction pour récupérer les disponibilités
async function fetchDisponibilites() {
    try {
        const validationResponse = await fetch(`/api/auth/validateToken`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`,
            }
        });

        if (!validationResponse.ok) {
            throw new Error('Token invalide ou expiré');
        }

        const { success, userid, error } = await validationResponse.json();
        
        if (!success || !studentId) {
            throw new Error(error || 'Échec de l\'authentification');
        }
        const response = await fetch(`/api/dispo/disponibilite?user_id=${userid}`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('accessToken')}`
            }
        });
        
        if (!response.ok) {
            throw new Error('Erreur lors du chargement des disponibilités');
        }
        
        const disponibilites = await response.json();
        
        // Masquer le message de chargement
        document.getElementById('loading-disponibilites').style.display = 'none';
        
        // Remplir le sélecteur de disponibilités
        const selectElement = document.getElementById('disponibilite_id');
        
        if (disponibilites.length === 0) {
            const option = document.createElement('option');
            option.value = "";
            option.textContent = "Aucune disponibilité trouvée";
            selectElement.appendChild(option);
            return;
        }
        
        disponibilites.forEach(dispo => {
            const option = document.createElement('option');
            option.value = dispo.id;
            
            // Formatter les dates pour l'affichage
            const startTime = new Date(dispo.start_time);
            const endTime = new Date(dispo.end_time);
            
            const formattedStart = startTime.toLocaleString('fr-FR', { 
                day: '2-digit', 
                month: '2-digit', 
                year: 'numeric', 
                hour: '2-digit', 
                minute: '2-digit' 
            });
            
            const formattedEnd = endTime.toLocaleTimeString('fr-FR', { 
                hour: '2-digit', 
                minute: '2-digit' 
            });
            
            option.textContent = `${formattedStart} - ${formattedEnd} (${dispo.price}$)`;
            selectElement.appendChild(option);
        });
    } catch (error) {
        console.error('Erreur:', error);
        document.getElementById('loading-disponibilites').textContent = 'Erreur lors du chargement des disponibilités';
    }
}

// Fonction pour récupérer les détails d'une disponibilité
async function fetchDisponibiliteDetails(disponibiliteId) {
    try {
        const response = await fetch(`/api/dispo/disponibilite/${disponibiliteId}`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('accessToken')}`
            }
        });
        
        if (!response.ok) {
            throw new Error('Erreur lors du chargement des détails de la disponibilité');
        }
        
        const disponibilite = await response.json();
        
        // Afficher les détails
        const detailsContainer = document.getElementById('disponibilite-details');
        const infoContainer = document.getElementById('disponibilite-info');
        const priceElement = document.getElementById('disponibilite-price');
        
        // Formatter les dates pour l'affichage
        const startTime = new Date(disponibilite.start_time);
        const endTime = new Date(disponibilite.end_time);
        
        const formattedStart = startTime.toLocaleString('fr-FR', { 
            day: '2-digit', 
            month: '2-digit', 
            year: 'numeric', 
            hour: '2-digit', 
            minute: '2-digit' 
        });
        
        const formattedEnd = endTime.toLocaleTimeString('fr-FR', { 
            hour: '2-digit', 
            minute: '2-digit' 
        });
        
        // Calculer la durée
        const durationMs = endTime - startTime;
        const durationMinutes = Math.round(durationMs / (1000 * 60));
        
        infoContainer.innerHTML = `
            <div style="margin-bottom: 0.5rem;">
                <strong>Date et heure:</strong> ${formattedStart} - ${formattedEnd}
            </div>
            <div style="margin-bottom: 0.5rem;">
                <strong>Durée:</strong> ${durationMinutes} minutes
            </div>
        `;
        
        priceElement.textContent = disponibilite.price || '0';
        
        detailsContainer.style.display = 'block';
    } catch (error) {
        console.error('Erreur:', error);
        alert('Erreur lors du chargement des détails de la disponibilité');
    }
}





