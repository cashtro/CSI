// 3. Ajouter cette fonction pour ouvrir le modal de demande d'enseignant
function openTeacherRequestModal() {
    // Créer le modal s'il n'existe pas déjà
    let requestModal = document.querySelector('.teacher-request-modal');
    if (requestModal) {
        document.body.removeChild(requestModal);
    }
    
    requestModal = document.createElement('div');
    requestModal.classList.add('teacher-request-modal');
    requestModal.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.6);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    `;
    
    requestModal.innerHTML = `
        <div class="modal-content" style="
            background-color: white;
            border-radius: 8px;
            padding: 2rem;
            width: 90%;
            max-width: 500px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        ">
            <h3 style="margin-top: 0; margin-bottom: 1.5rem; color: #333;">Become a Teacher</h3>
            
            <form id="teacher-request-form">
                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label for="teacher-request-message" style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Tell us why you want to become a teacher</label>
                    <textarea id="teacher-request-message" name="message" rows="5" required style="
                        width: 100%;
                        padding: 0.75rem;
                        border: 1px solid #ddd;
                        border-radius: 4px;
                        font-size: 1rem;
                        resize: vertical;
                    "></textarea>
                    <small style="color: #666; display: block; margin-top: 0.5rem;">
                        Please describe your expertise, teaching experience, and what subjects you'd like to teach.
                    </small>
                </div>
                
                <div class="form-actions" style="
                    display: flex;
                    justify-content: flex-end;
                    gap: 1rem;
                    margin-top: 2rem;
                ">
                    <button type="button" class="cancel-btn" style="
                        padding: 0.75rem 1.5rem;
                        background-color: #f1f1f1;
                        color: #333;
                        border: none;
                        border-radius: 4px;
                        cursor: pointer;
                        font-weight: 500;
                    ">Cancel</button>
                    <button type="submit" class="submit-btn" style="
                        padding: 0.75rem 1.5rem;
                        background-color: #4CAF50;
                        color: white;
                        border: none;
                        border-radius: 4px;
                        cursor: pointer;
                        font-weight: 500;
                    ">Submit Request</button>
                </div>
            </form>
        </div>
    `;
    
    document.body.appendChild(requestModal);
    
    // Fermer le modal
    requestModal.querySelector('.cancel-btn').addEventListener('click', () => {
        document.body.removeChild(requestModal);
    });
    
    // Fermer en cliquant en dehors
    requestModal.addEventListener('click', (e) => {
        if (e.target === requestModal) {
            document.body.removeChild(requestModal);
        }
    });
    
    // Gérer la soumission du formulaire
    requestModal.querySelector('#teacher-request-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const submitBtn = e.target.querySelector('.submit-btn');
        const originalBtnText = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting...';
        
        try {
            const message = document.getElementById('teacher-request-message').value;
            
            // Récupérer l'ID de l'utilisateur
            const validationResponse = await fetch(`/api/auth/validateToken`, {
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`,
                }
            });
            
            const { userid: id_prof } = await validationResponse.json();
            
            // Envoyer la demande en utilisant l'API de demandcrud.js
            const response = await fetch('/api/teacher/newRequest', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`
                },
                body: JSON.stringify({ id_prof, message })
            });
          
            if (response.ok) {
                alert('Your request has been submitted successfully! We will review it soon.');
                document.body.removeChild(requestModal);
            } else {
                const errorData = await response.json();
                alert(`Error: ${errorData.error || 'Unable to submit request'}`);
            }
        } catch (error) {
            console.error('Error:', error);
            alert('An error occurred while submitting your request');
        } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = originalBtnText;
        }
    });
}

/// 2. Modifier updateShowPageWithTeacherCheck pour bloquer aussi la section meet
async function updateShowPageWithTeacherCheck() {
    // Sauvegarder la fonction originale
    const originalShowPage = window.showPage;
    
    window.showPage = async function(pageName) {
        // Vérifier si l'utilisateur est un enseignant
        const isTeacher = await checkIfUserIsTeacher();
        
        // Si l'utilisateur n'est pas un enseignant et essaie d'accéder aux sections réservées
        if (!isTeacher && (pageName === 'appointment' || pageName === 'meet')) {
            // Rediriger vers le tableau de bord
            document.querySelectorAll('.page-content').forEach(content => {
                content.classList.remove('active');
            });
            
            // Afficher le tableau de bord
            const dashboardContent = document.getElementById('dashboard-content');
            if (dashboardContent) {
                dashboardContent.classList.add('active');
            }
            
            // Mettre à jour le titre de la page
            const pageTitle = document.querySelector('.page-title');
            if (pageTitle) {
                pageTitle.textContent = 'Dashboard';
            }
            
            // Déselectionner l'élément de menu actif et sélectionner le tableau de bord
            document.querySelectorAll('.menu-item').forEach(item => {
                item.classList.remove('active');
            });
            
            const dashboardItem = document.querySelector('.menu-item[data-page="dashboard"]');
            if (dashboardItem) {
                dashboardItem.classList.add('active');
            }
            
            alert('You need to be a teacher to access this section');
            return;
        }
        
        // Appeler la fonction originale
        originalShowPage(pageName);
    };
}

