// Fonction pour ouvrir le modal de modification de cours
function openCourseEditModal(course) {
    // Créer le modal s'il n'existe pas déjà
    let editModal = document.querySelector('.course-edit-modal');
    if (!editModal) {
        editModal = document.createElement('div');
        editModal.classList.add('course-edit-modal');
        editModal.style.display = 'none';
        editModal.innerHTML = `
            <div class="modal-content">
                <h3>Modifier le cours</h3>
                <form id="edit-course-form" class="edit-form" enctype="multipart/form-data">
                    <input type="hidden" id="edit-course-id" name="id">
                    
                    <div class="form-group">
                        <label for="edit-course-title">Titre du cours</label>
                        <input type="text" id="edit-course-title" name="nom" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="edit-course-description">Description</label>
                        <textarea id="edit-course-description" name="description" rows="3"></textarea>
                    </div>
                    
                    <div class="form-group">
                        <label for="edit-course-niveau">Niveau</label>
                        <select id="edit-course-niveau" name="niveau" required>
                            <option value="débutant">Débutant</option>
                            <option value="intermédiaire">Intermédiaire</option>
                            <option value="avancé">Avancé</option>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label for="edit-course-heures">Nombre d'heures</label>
                        <input type="number" id="edit-course-heures" name="nombre_heures" min="1" max="500" required>
                        <small class="hint">Durée totale du cours en heures</small>
                    </div>
                    
                    <div class="form-group">
                        <label for="edit-course-prix">Prix ($)</label>
                        <input type="number" id="edit-course-prix" name="prix" step="0.01" min="0">
                    </div>
                    
                    <div class="form-group">
                        <label for="edit-course-files">Ajouter de nouveaux fichiers</label>
                        <input type="file" id="edit-course-files" name="files" multiple>
                        <small class="hint">Formats acceptés: PDF, MP4, ZIP (max 50MB)</small>
                    </div>
                    
                    <div class="form-actions">
                        <button type="button" class="cancel-btn">Annuler</button>
                        <button type="submit" class="submit-btn">Mettre à jour</button>
                    </div>
                </form>
            </div>
        `;
        document.body.appendChild(editModal);
        
        // Fermer le modal
        editModal.querySelector('.cancel-btn').addEventListener('click', () => {
            editModal.style.display = 'none';
        });
        
        // Fermer en cliquant en dehors
        editModal.addEventListener('click', (e) => {
            if (e.target === editModal) {
                editModal.style.display = 'none';
            }
        });
        
        // Gérer la soumission du formulaire
        editModal.querySelector('#edit-course-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = e.target;
            const courseId = form.querySelector('#edit-course-id').value;
            
            // Créer un FormData pour envoyer les données, y compris les fichiers
            const formData = new FormData(form);
            
            try {
                const response = await fetch(`/api/course/${courseId}`, {
                    method: 'PUT',
                    body: formData,
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('accessToken')}`
                    }
                });
                
                if (response.ok) {
                    alert('Cours mis à jour avec succès!');
                    editModal.style.display = 'none';
                    // Rafraîchir la liste des cours
                    displayCoursesTeacher();
                } else {
                    const errorData = await response.json();
                    alert(`Erreur: ${errorData.error || errorData.message || 'Impossible de mettre à jour le cours'}`);
                }
            } catch (error) {
                console.error('Erreur lors de la mise à jour du cours:', error);
                alert('Une erreur est survenue lors de la mise à jour du cours');
            }
        });
    }


 
    
    // Préremplir le formulaire avec les données du cours
    document.getElementById('edit-course-id').value = course.id;
    document.getElementById('edit-course-title').value = course.nom || '';
    document.getElementById('edit-course-description').value = course.description || '';
    document.getElementById('edit-course-niveau').value = course.niveau || 'débutant';
    document.getElementById('edit-course-heures').value = course.nombre_heures || '';
    document.getElementById('edit-course-prix').value = course.prix || 0;
    
    // Afficher le modal
    editModal.style.display = 'flex';
}

// Gestion du modal pour ajouter un cours dans la section Teacher
document.addEventListener('DOMContentLoaded', function() {
    // Référence au bouton et au modal
    const addTeacherCourseBtn = document.getElementById('add-teacher-course-btn');
    const teacherCourseModal = document.getElementById('teacher-course-modal');
    
    if (addTeacherCourseBtn && teacherCourseModal) {
        // Afficher le modal au clic sur le bouton
        addTeacherCourseBtn.addEventListener('click', function() {
            teacherCourseModal.style.display = 'flex';
        });
        
        // Fermer le modal en cliquant en dehors
        teacherCourseModal.addEventListener('click', function(e) {
            if (e.target === teacherCourseModal) {
                teacherCourseModal.style.display = 'none';
            }
        });
        
        // Gestion des étapes du formulaire
        const formSteps = teacherCourseModal.querySelectorAll('.form-step');
        const nextButtons = teacherCourseModal.querySelectorAll('.next-step');
        const prevButtons = teacherCourseModal.querySelectorAll('.prev-step');
        
        nextButtons.forEach(button => {
            button.addEventListener('click', function() {
                // Trouver l'étape actuelle et la prochaine
                const currentStep = this.closest('.form-step');
                const currentStepNum = parseInt(currentStep.dataset.step);
                const nextStep = teacherCourseModal.querySelector(`.form-step[data-step="${currentStepNum + 1}"]`);
                
                if (nextStep) {
                    // Valider les champs requis de l'étape actuelle
                    const requiredFields = currentStep.querySelectorAll('input[required], select[required]');
                    let isValid = true;
                    
                    requiredFields.forEach(field => {
                        if (!field.value) {
                            isValid = false;
                            field.classList.add('invalid');
                        } else {
                            field.classList.remove('invalid');
                        }
                    });
                    
                    if (isValid) {
                        currentStep.classList.remove('active');
                        nextStep.classList.add('active');
                    }
                }
            });
        });
        
        prevButtons.forEach(button => {
            button.addEventListener('click', function() {
                // Trouver l'étape actuelle et la précédente
                const currentStep = this.closest('.form-step');
                const currentStepNum = parseInt(currentStep.dataset.step);
                const prevStep = teacherCourseModal.querySelector(`.form-step[data-step="${currentStepNum - 1}"]`);
                
                if (prevStep) {
                    currentStep.classList.remove('active');
                    prevStep.classList.add('active');
                }
            });
        });
        
        // Gestion des listes dynamiques
        const addItemButtons = teacherCourseModal.querySelectorAll('.add-item');
        
        addItemButtons.forEach(button => {
            button.addEventListener('click', function() {
                const list = this.previousElementSibling;
                const newItem = list.querySelector('.list-item').cloneNode(true);
                const input = newItem.querySelector('input');
                input.value = '';
                
                // Ajouter l'événement pour supprimer l'élément
                const removeButton = newItem.querySelector('.remove-item');
                removeButton.addEventListener('click', function() {
                    if (list.querySelectorAll('.list-item').length > 1) {
                        newItem.remove();
                    }
                });
                
                list.appendChild(newItem);
            });
        });
        
        // Ajouter les gestionnaires d'événements pour les boutons de suppression existants
        teacherCourseModal.querySelectorAll('.remove-item').forEach(button => {
            button.addEventListener('click', function() {
                const list = this.closest('.dynamic-list');
                if (list.querySelectorAll('.list-item').length > 1) {
                    this.closest('.list-item').remove();
                }
            });
        });
        
        // Gestion de la soumission du formulaire
        const addTeacherCourseForm = document.getElementById('add-teacher-course-form');
        
        if (addTeacherCourseForm) {
            addTeacherCourseForm.addEventListener('submit', async function(e) {
                e.preventDefault();

                const submitBtn = this.querySelector('button[type="submit"]');
                const originalBtnContent = submitBtn.innerHTML;
                submitBtn.innerHTML = `
                    <div class="btn-spinner" style="
                        display: inline-block;
                        width: 20px;
                        height: 20px;
                        border: 2px solid #f3f3f3;
                        border-top: 2px solid #3498db;
                        border-radius: 50%;
                        animation: spin 1s linear infinite;
                        margin-right: 8px;">
                    </div>
                    Création en cours...
                `;
                submitBtn.disabled = true;

                
                // Préparer les données à envoyer
                const formData = new FormData(this);
                
                // Collecter les points d'apprentissage et le programme
                const learningPoints = [];
                teacherCourseModal.querySelectorAll('#teacher-learning-points .list-item input').forEach(input => {
                    if (input.value) learningPoints.push(input.value);
                });
                
                const programPoints = [];
                teacherCourseModal.querySelectorAll('#teacher-program .list-item input').forEach(input => {
                    if (input.value) programPoints.push(input.value);
                });
                
                // Créer un objet content structuré
                const content = {
                    learning_points: learningPoints,
                    program: programPoints
                };
                
                // Ajouter l'objet content au formData
                formData.append('content', JSON.stringify(content));
                
                // Créer des lessons à partir des fichiers
                const files = formData.getAll('files');
                const lessons = files.map((file, index) => {
                    // Déterminer le type en fonction de l'extension du fichier
                    let type = 'pdf'; // par défaut
                    if (file.name.endsWith('.mp4')) type = 'video';
                    if (file.name.endsWith('.txt')) type = 'txt';
                    if (file.name.endsWith('.png')) type = 'png';
                    
                    return {
                        title: `Lesson ${index + 1}`,
                        type,
                        url: null // sera rempli par le serveur
                    };
                });
                
                formData.append('lessons', JSON.stringify(lessons));
                
                try {
                    const response = await fetch('/api/course/add-course', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'Authorization': `Bearer ${localStorage.getItem('accessToken')}`
                        }
                    });
                    
                    if (response.ok) {
                        const newCourse = await response.json();
                        alert('Cours ajouté avec succès!');
                        teacherCourseModal.style.display = 'none';
                        addTeacherCourseForm.reset();
                        
                        // Réinitialiser les étapes du formulaire
                        formSteps.forEach(step => {
                            step.classList.remove('active');
                        });
                        formSteps[0].classList.add('active');
                        
                        // Rafraîchir la liste des cours
                        displayCoursesTeacher();
                    } else {
                        const errorData = await response.json();
                        alert(`Erreur: ${errorData.error || 'Impossible d\'ajouter le cours'}`);
                    }
                } catch (error) {
                    console.error('Erreur lors de l\'ajout du cours:', error);
                    alert('Une erreur est survenue lors de l\'ajout du cours');
                } finally{
                    submitBtn.innerHTML = originalBtnContent;
                    submitBtn.disabled = false;
                }
            });
        }
    }
    
    // Ajouter des styles CSS pour le modal et les étapes
    const styleElement = document.createElement('style');
    styleElement.id = 'teacher-course-modal-styles';
    styleElement.textContent = `
        .form-steps {
            position: relative;
            width: 100%;
        }
        
        .form-step {
            display: none;
            width: 100%;
        }
        
        .form-step.active {
            display: block;
        }
        
        .step-nav {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }
        
        .next-step, .prev-step {
            padding: 8px 16px;
            background-color: #2196F3;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 500;
        }
        
        .prev-step {
            background-color: #f1f1f1;
            color: #333;
        }
        
        .dynamic-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 10px;
        }
        
        .list-item {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .list-item input {
            flex: 1;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }
        
        .remove-item {
            background: none;
            border: none;
            color: #ff5252;
            font-size: 20px;
            cursor: pointer;
            padding: 0;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .add-item {
            background: none;
            border: none;
            color: #2196F3;
            cursor: pointer;
            padding: 5px 0;
            font-size: 14px;
            font-weight: 500;
            align-self: flex-start;
        }
        
        input.invalid {
            border-color: #ff5252;
            background-color: #fff8f8;
        }
    `;
    
    document.head.appendChild(styleElement);
});

