// Fonction pour marquer une leçon comme terminée
async function marquerLeconCommeTerminee(courseId, lessonIndex) {
    try {
        // Obtenir l'ID de l'utilisateur actuel
        const validationResponse = await fetch(`/api/auth/validateToken`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`,
            }
        });

        if (!validationResponse.ok) {
            throw new Error('Token invalide ou expiré');
        }

        const { success, userid: studentId, error } = await validationResponse.json();
        
        if (!success || !studentId) {
            throw new Error(error || 'Échec de l\'authentification');
        }

        
        // Calculer la progression - une leçon est terminée sur le nombre total de leçons
        const lessonCount = document.querySelectorAll('.lecon-item').length;
        const lessonValue = 1 / lessonCount;
        
        // Calculer la nouvelle progression comme si la leçon actuelle était la seule complétée
        // Cette méthode est plus robuste que d'essayer de récupérer la progression existante
        const newProgress = Math.min(1, ((parseInt(lessonIndex) + 1) / lessonCount));
        
        
        // Mettre à jour la progression du cours
        const updateResponse = await fetch(`/api/course/update-progress/${studentId}/${courseId}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${localStorage.getItem('accessToken')}`
            },
            body: JSON.stringify({ amount_completed: newProgress })
        });

        if (!updateResponse.ok) {
            const errorData = await updateResponse.json();
            throw new Error(errorData.error || 'Impossible de mettre à jour la progression');
        }
            
        return {
            success: true,
            newProgress,
            message: 'Leçon marquée comme terminée'
        };
    } catch (error) {
        console.error('Erreur:', error);
        return {
            success: false,
            message: error.message
        };
    }
}




// Fonction pour récupérer les rendez-vous depuis l'API
async function fetchAppointments() {
    try {
        const validationResponse = await fetch(`/api/auth/validateToken`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`,
            }
        });

        if (!validationResponse.ok) {
            throw new Error('Token invalide ou expiré');
        }

        const { success, userid, error } = await validationResponse.json();
        
        if (!success || !studentId) {
            throw new Error(error || 'Échec de l\'authentification');
        }
        const response = await fetch(`/api/rdv/all?userId=${userid}`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('accessToken')}`
            }
        });
        
        if (!response.ok) {
            throw new Error('Erreur lors du chargement des rendez-vous');
        }
        
        const result = await response.json();
        return result.data || [];
    } catch (error) {
        console.error('Erreur:', error);
        return [];
    }
}





// Fonction pour afficher les rendez-vous dans l'interface
async function displayAppointments() {
    const appointmentList = document.getElementById('appointment-list');
    if (!appointmentList) {
        console.error("L'élément appointment-list est introuvable");
        return;
    }
    
    appointmentList.innerHTML = '<div class="loading-courses"><div class="spinner"></div><p>Chargement des rendez-vous...</p></div>';

    try {
        const appointments = await fetchAppointments();
        
        // Si l'utilisateur n'est pas connecté
        if (appointments.noUser) {
            appointmentList.innerHTML = '<div class="no-courses">Vous n\'avez pas accès aux rendez-vous</div>';
            return;
        }

        if (appointments.length === 0) {
            appointmentList.innerHTML = '<div class="no-courses">Aucun rendez-vous disponible pour le moment</div>';
            return;
        }

        appointmentList.innerHTML = '';

        appointments.forEach(appointment => {
            const appointmentCard = document.createElement('div');
            appointmentCard.className = 'content-card';
            appointmentCard.dataset.appointmentId = appointment.id;
            
            // Formater la date
            let formattedDate = 'Date non disponible';
            if (appointment.date) {
                const date = new Date(appointment.date);
                formattedDate = date.toLocaleDateString('fr-FR', {
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric'
                });
            }
            
            appointmentCard.innerHTML = `
                <div class="content-card-title">Rendez-vous du ${formattedDate}</div>
                <div class="content-card-value">Heure: ${appointment.heure || 'Non spécifiée'}</div>
                <div class="content-card-desc">Durée: ${appointment.duree || '30'} minutes</div>
                <div class="content-card-actions">
                    <button class="edit-appointment-btn">Modifier</button>
                    <button class="cancel-appointment-btn">Annuler</button>
                </div>
            `;
            appointmentList.appendChild(appointmentCard);
            
            // Ajouter les événements pour modifier et annuler
            const editBtn = appointmentCard.querySelector('.edit-appointment-btn');
            editBtn.addEventListener('click', () => {
                openAppointmentEditModal(appointment);
            });
            
            const cancelBtn = appointmentCard.querySelector('.cancel-appointment-btn');
            cancelBtn.addEventListener('click', async () => {
                if (confirm('Êtes-vous sûr de vouloir annuler ce rendez-vous?')) {
                    try {
                        const response = await fetch(`/api/rdv/cancel/${appointment.id}`, {
                            method: 'DELETE',
                            headers: {
                                'Authorization': `Bearer ${localStorage.getItem('accessToken')}`
                            }
                        });
                        
                        if (response.ok) {
                            appointmentCard.remove();
                            alert('Rendez-vous annulé avec succès!');
                        } else {
                            const errorData = await response.json();
                            alert(`Erreur: ${errorData.message || 'Impossible d\'annuler le rendez-vous'}`);
                        }
                    } catch (error) {
                        console.error('Erreur:', error);
                        alert('Une erreur est survenue lors de l\'annulation du rendez-vous');
                    }
                }
            });
        });
    } catch (error) {
        appointmentList.innerHTML = `<div class="error-loading">Erreur: ${error.message}</div>`;
    }
}

