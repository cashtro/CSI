// 5. Fonction pour mettre à jour la fonction showPage
function updateShowPageFunction() {
    window.showPage = function(pageName) {
        
        // Cacher toutes les pages
        document.querySelectorAll('.page-content').forEach(content => {
            content.classList.remove('active');
        });

        // Afficher la page demandée
        const pageToShow = document.getElementById(`${pageName}-content`);
        if (pageToShow) {
            pageToShow.classList.add('active');

            if (pageName === 'courses') {
                displayCourses();
            } else if (pageName === 'teacher') {
                displayCoursesTeacher();
            } else if (pageName === 'appointment') {
                // Afficher les disponibilités pour la section appointment
                displayAvailabilities();
                addCreateAvailabilityButton();
            } else if (pageName === 'meet') {
                // Afficher les réunions pour la section meet
                if (typeof displayMeetings === 'function') {
                    displayMeetings();
                } else {
                    console.error("La fonction displayMeetings n'est pas définie");
                }
            } else if (pageName === 'draws') {
                displayDraws();
            }
        } else {
            document.getElementById('dashboard-content').classList.add('active');
        }
    };
}

// 6. Initialisation
function initAvailabilityFunctions() {
    
    // Mettre à jour la fonction showPage
    updateShowPageFunction();
    
    // Vérifier quelle page est active et appliquer la fonction appropriée
    const activeContent = document.querySelector('.page-content.active');
    if (activeContent) {
        
        if (activeContent.id === 'appointment-content') {
            displayAvailabilities();
            addCreateAvailabilityButton();
        }
    }
    
    // Ajouter des gestionnaires d'événements pour les éléments du menu
    const appointmentMenuItem = document.querySelector('.menu-item[data-page="appointment"]');
    if (appointmentMenuItem) {
        
        appointmentMenuItem.addEventListener('click', function() {
            setTimeout(() => {
                displayAvailabilities();
                addCreateAvailabilityButton();
            }, 100);
        });
    }
}

// Exécuter l'initialisation quand le document est chargé
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAvailabilityFunctions);
} else {
    initAvailabilityFunctions();
}

async function displayMeetings() {
    
    const meetList = document.getElementById('meet-list');
    
    if (!meetList) {
        console.error("L'élément meet-list est introuvable");
        // Essayer de trouver la section et d'ajouter l'ID
        const meetSection = document.getElementById('meet-content');
        if (meetSection) {
            const contentBody = meetSection.querySelector('.content-body');
            if (contentBody) {
                contentBody.id = 'meet-list';
                return displayMeetings(); // Appeler à nouveau la fonction
            }
        }
        return;
    }
    
    meetList.innerHTML = '<div class="loading-data"><div class="spinner"></div><p>Chargement des réunions...</p></div>';

    try {
        // Ajouter les styles pour les badges de statut (correction du sélecteur)
        if (!document.getElementById('meeting-status-styles')) {
            const styleElement = document.createElement('style');
            styleElement.id = 'meeting-status-styles';
            styleElement.textContent = `
                .meeting-status {
                    display: inline-block;
                    padding: 2px 8px;
                    border-radius: 12px;
                    font-size: 0.75rem;
                    font-weight: 500;
                    margin-left: 8px;
                }
                .status-active {
                    background-color: #4CAF50;
                    color: white;
                }
                .status-scheduled {
                    background-color: #2196F3;
                    color: white;
                }
                .status-past {
                    background-color: #9e9e9e;
                    color: white;
                }
            `;
            document.head.appendChild(styleElement);
        }
        
        // Récupérer l'ID de l'utilisateur connecté
        
        const validationresponse = await fetch(`/api/auth/validateToken`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`,
            }
        });

        const { success, userid, error } = await validationresponse.json();
        
        if (!userid) {
            meetList.innerHTML = '<div class="no-data">Vous devez être connecté pour voir vos réunions</div>';
            return;
        }
        
        // Récupérer les rendez-vous depuis l'API
        const response = await fetch(`/api/rdv/all?userId=${userid}`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`,
            }
        });
        
        if (!response.ok) {
            meetList.innerHTML = `<div class="error-state">Erreur lors du chargement des réunions (${response.status})</div>`;
            return;
        }
        
        const result = await response.json();
        
        const meetings = result.data || [];

        if (meetings.length === 0) {
            meetList.innerHTML = '<div class="no-data">Aucune réunion disponible</div>';
            return;
        }

        meetList.innerHTML = '';

        meetings.forEach(meeting => {
            // Skip if the meeting doesn't have required data
            if (!meeting.date || !meeting.heure) {
                console.warn("Rendez-vous incomplet ignoré:", meeting);
                return;
            }
            
            const meetingCard = document.createElement('div');
            meetingCard.className = 'content-card';
            meetingCard.dataset.meetingId = meeting.id;
            
            // Déterminer si la réunion est active ou programmée
            const now = new Date();
            const meetingDate = new Date(meeting.date);
            
            // Handle time conversion correctly
            const timeArr = meeting.heure.split(':');
            meetingDate.setHours(
                parseInt(timeArr[0] || 0), 
                parseInt(timeArr[1] || 0)
            );
            
            const meetingEndTime = new Date(meetingDate);
            meetingEndTime.setMinutes(meetingEndTime.getMinutes() + parseInt(meeting.duree || 30));
            
            const isActive = now >= meetingDate && now <= meetingEndTime;
            const isPast = now > meetingEndTime;
            
            // Status badge
            let statusClass = isActive ? 'status-active' : (isPast ? 'status-past' : 'status-scheduled');
            let statusText = isActive ? 'En cours' : (isPast ? 'Terminé' : 'Programmé');
            
            // Formater la date pour l'affichage
            const formattedDate = new Date(meeting.date).toLocaleDateString('fr-FR', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric'
            });
            
            meetingCard.innerHTML = `
                <div class="content-card-title">
                    Rendez-vous du ${formattedDate}
                    <span class="meeting-status ${statusClass}">${statusText}</span>
                </div>
                <div class="content-card-value">Heure: ${meeting.heure || 'Non spécifiée'}</div>
                <div class="content-card-desc">
                    <div>Durée: ${meeting.duree || 30} minutes</div>
                    ${meeting.ID_vendeur ? `<div>Professeur ID: ${meeting.ID_vendeur}</div>` : ''}
                </div>
                <div class="content-card-actions">
                    ${isActive 
                        ? `<button class="join-meeting-btn">Rejoindre</button>` 
                        : isPast 
                            ? `<button class="view-recording-btn">Voir l'enregistrement</button>` 
                            : `<button class="edit-meeting-btn">Modifier</button>
                               <button class="cancel-meeting-btn">Annuler</button>`}
                </div>
            `;
            
            meetList.appendChild(meetingCard);
            
            // Event listeners for buttons
            const joinBtn = meetingCard.querySelector('.join-meeting-btn');
            if (joinBtn) {
                joinBtn.addEventListener('click', () => {
                    window.location.href = `/meeting-room/${meeting.id}`;
                });
            }
            
            const viewRecordingBtn = meetingCard.querySelector('.view-recording-btn');
            if (viewRecordingBtn) {
                viewRecordingBtn.addEventListener('click', () => {
                    alert('Fonctionnalité d\'enregistrement à venir');
                });
            }
            
            const editBtn = meetingCard.querySelector('.edit-meeting-btn');
            if (editBtn) {
                editBtn.addEventListener('click', () => {
                    if (typeof openAppointmentEditModal === 'function') {
                        openAppointmentEditModal(meeting);
                    } else {
                        alert('Fonction de modification non disponible');
                    }
                });
            }
            
            const cancelBtn = meetingCard.querySelector('.cancel-meeting-btn');
            if (cancelBtn) {
                cancelBtn.addEventListener('click', async () => {
                    if (confirm('Êtes-vous sûr de vouloir annuler ce rendez-vous?')) {
                        try {
                            const response = await fetch(`/api/rdv/cancel/${meeting.id}`, {
                                method: 'DELETE',
                                headers: {
                                    'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`
                                }
                            });
                            
                            if (response.ok) {
                                meetingCard.remove();
                                alert('Rendez-vous annulé avec succès!');
                            } else {
                                const errorData = await response.json();
                                alert(`Erreur: ${errorData.message || 'Impossible d\'annuler le rendez-vous'}`);
                            }
                        } catch (error) {
                            console.error('Erreur:', error);
                            alert('Une erreur est survenue lors de l\'annulation du rendez-vous');
