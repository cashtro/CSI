function checkAuthentication() {
    // Récupérer le token d'accès
    const accessToken = localStorage.getItem('accessToken');
    
    // Aucun token trouvé, rediriger vers la page de connexion
    if (!accessToken) {
        // Sauvegarder l'URL actuelle pour y revenir après la connexion
        localStorage.setItem('redirectAfterLogin', window.location.href);
        // Rediriger vers la page de connexion
        window.location.href = '/login';
        return false;
    }
    
    // Utiliser la nouvelle route dédiée pour le dashboard
    return fetch('/api/auth/dashboard-auth-check', {
        method: 'POST',
        headers: {
            'Authorization': `Bearer ${accessToken}`,
            'Content-Type': 'application/json'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (!data.success) {
            // Token invalide, supprimer et rediriger
            localStorage.removeItem('accessToken');
            localStorage.setItem('redirectAfterLogin', window.location.href);
            window.location.href = '/login';
            return false;
        }
        
        // Stocker des informations utilisateur si nécessaire
        if (data.user && data.user.id) {
            localStorage.setItem('userId', data.user.id);
        }
        
        return true;
    })
    .catch(error => {
        console.error('Erreur lors de la validation du token:', error);
        // En cas d'erreur réseau, on laisse passer mais on log l'erreur
        return true;
    });
}
// À exécuter après une connexion réussie
function afterSuccessfulLogin(accessToken, userId) {
    // Stocker le token et l'ID utilisateur
    localStorage.setItem('accessToken', accessToken);
    localStorage.setItem('userId', userId);
    
    // Vérifier s'il y a une URL de redirection
    const redirectUrl = localStorage.getItem('redirectAfterLogin');
    if (redirectUrl) {
        localStorage.removeItem('redirectAfterLogin');
        window.location.href = redirectUrl;
    } else {
        window.location.href = '/dashboard';
    }
}




async function fetchCourses() {
    try {
        // 1. Validation du token et récupération du userid
        const validationResponse = await fetch(`/api/auth/validateToken`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`,
            }
        });

        if (!validationResponse.ok) {
            throw new Error('Token invalide ou expiré');
        }

        const { success, userid: studentId, error } = await validationResponse.json();
        
        if (!success || !studentId) {
            throw new Error(error || 'Échec de l\'authentification');
        }


        // 2. Maintenant on utilise le studentId vérifié
        const response = await fetch(`/api/course/student-courses/${studentId}`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('accessToken')}`
            }
        });

        if (!response.ok) {
            throw new Error('Erreur lors du chargement des cours');
        }

        return await response.json();
    } catch (error) {
        console.error('Erreur:', error);
        return [];
    }
}

async function displayCourses() {
    const coursesList = document.getElementById('courses-list');
    coursesList.innerHTML = '<div class="loading-courses"><div class="spinner"></div><p>Chargement des cours...</p></div>';

    try {
        const courses = await fetchCourses();

        if (courses.length === 0) {
            coursesList.innerHTML = '<div class="no-courses">Aucun cours disponible pour le moment</div>';
            return;
        }

        coursesList.innerHTML = '';

        courses.forEach(course => {
            const courseCard = document.createElement('div');
            courseCard.className = 'content-card';
            courseCard.dataset.courseId = course.id;
            courseCard.innerHTML = `
                <div class="content-card-title">${course.nom || 'Sans titre'}</div>
                <div class="content-card-value">${course.student_count || 0} étudiants</div>
                <div class="content-card-desc">${course.description || 'Aucune description'}</div>
                <div class="content-card-actions">
                    <button class="view-course-btn">Voir détails</button>
                </div>
            `;
            coursesList.appendChild(courseCard);
            
            // Événement pour la CARTE (ouvre le résumé)
            courseCard.addEventListener('click', function(e) {
                // Si le clic vient du bouton, on ne fait rien
                if (e.target.closest('.view-course-btn')) return;
                
                // Ouvre le modal de résumé
                if (typeof openCourseSummaryModal === 'function') {
                    openCourseSummaryModal(course.id);
                }
            });
            
            // Événement pour le BOUTON (ouvre les détails)
            const viewCourseBtn = courseCard.querySelector('.view-course-btn');
            viewCourseBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation(); // Empêche le déclenchement de l'événement de la carte
                
                if (typeof openCourseDetailsModal === 'function') {
                    openCourseDetailsModal(course.id);
                }
            });
        });
    } catch (error) {
        coursesList.innerHTML = `<div class="error-loading">Erreur: ${error.message}</div>`;
    }
}



// Fonction pour récupérer la progression du cours
async function fetchCourseProgress(courseId) {
    try {
        // 1. Validation du token et récupération du userid
        const validationResponse = await fetch(`/api/auth/validateToken`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`,
            }
        });
 
        if (!validationResponse.ok) {
            throw new Error('Token invalide ou expiré');
        }
 
        const { success, userid: studentId, error } = await validationResponse.json();
       
        if (!success || !studentId) {
            throw new Error(error || 'Échec de l\'authentification');
        }
 
        
        // Utiliser une route existante ou simuler la progression
        const response = await fetch(`/api/course/student-progress/${studentId}`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('accessToken')}`
            }
        });

        if (!response.ok) {
            throw new Error('Erreur lors de la récupération de la progression');
        }

        const progressData = await response.json();
        
        // Trouver la progression pour ce cours spécifique
        const courseProgress = progressData.find(progress => progress.course_id === courseId);
        
        return courseProgress 
            ? { 
                amount_completed: courseProgress.amount_completed || 0,
                course_id: courseId 
              }
            : { 
                amount_completed: 0,
                course_id: courseId 
              };
    } catch (error) {
        console.error('Erreur lors de la récupération de la progression:', error);
        return { amount_completed: 0, course_id: courseId };
    }
}

async function updateCourseProgress(courseId, progressAmount) {
    try {
       // 1. Validation du token et récupération du userid
       const validationResponse = await fetch(`/api/auth/validateToken`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`,
            }
        });
 
        if (!validationResponse.ok) {
            throw new Error('Token invalide ou expiré');
        }
 
        const { success, userid: studentId, error } = await validationResponse.json();
       
        if (!success || !studentId) {
            throw new Error(error || 'Échec de l\'authentification');
        }
 

        const response = await fetch(`/api/course/update-progress/${studentId}/${courseId}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${localStorage.getItem('accessToken')}`
            },
            body: JSON.stringify({ amount_completed: progressAmount })
        });

        if (!response.ok) {
            throw new Error('Impossible de mettre à jour la progression');
        }

        return await response.json();
    } catch (error) {
        console.error('Erreur lors de la mise à jour de la progression:', error);
        alert(error.message); // Ajoute une alerte plus utile
        return null;
    }
}


