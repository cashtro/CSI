        createMeetingCard.className = 'content-card add-new-card';
        createMeetingCard.style.cssText = `
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
            cursor: pointer;
            background-color: #f9f9f9;
            border: 2px dashed #ddd;
            transition: all 0.3s ease;
        `;
        
        createMeetingCard.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="16"></line>
                <line x1="8" y1="12" x2="16" y2="12"></line>
            </svg>
            <div class="add-text" style="margin-top: 10px; font-weight: 500;">Créer un nouveau rendez-vous</div>
        `;
        
        meetList.appendChild(createMeetingCard);
        
        // Event listener for create card
        createMeetingCard.addEventListener('click', () => {
            if (typeof openCreateAppointmentModal === 'function') {
                openCreateAppointmentModal();
            } else {
                alert('Fonction de création de rendez-vous non disponible');
            }
        });
        
    } catch (error) {
        console.error('Erreur complète:', error);
        meetList.innerHTML = `<div class="error-state">Une erreur est survenue lors du chargement des réunions: ${error.message}</div>`;
    }
}

// Update the showPage function to correctly display the meetings section
function updateShowPageFunction() {
    // Make sure these functions are defined before we override showPage
    if (typeof displayCourses !== 'function' || 
        typeof displayCoursesTeacher !== 'function' || 
        typeof displayDraws !== 'function') {
        console.error("Required functions not defined yet");
        return;
    }

    window.showPage = function(pageName) {
        // Cacher toutes les pages
        document.querySelectorAll('.page-content').forEach(content => {
            content.classList.remove('active');
        });

        // Afficher la page demandée
        const pageToShow = document.getElementById(`${pageName}-content`);
        if (pageToShow) {
            pageToShow.classList.add('active');

            if (pageName === 'courses') {
                displayCourses();
            } else if (pageName === 'teacher') {
                displayCoursesTeacher();
            } else if (pageName === 'appointment') {
                // Afficher les disponibilités pour la section appointment
                displayAvailabilities();
                addCreateAvailabilityButton();
            } else if (pageName === 'meet') {
                // Afficher les réunions pour la section meet
                displayMeetings();
            } else if (pageName === 'draws') {
                displayDraws();
            }
        } else {
            document.getElementById('dashboard-content').classList.add('active');
        }
    };
}

// Initialiser les modifications après le chargement du document
document.addEventListener('DOMContentLoaded', function() {
    // Mettre à jour la fonction showPage
    updateShowPageFunction();
    
