<script>
function initializeMainCanvas() {
    const tagsContainer = document.getElementById('tagsContainer');
    const canvas = document.getElementById('lottery-canvas-main');

    if (!tagsContainer || !canvas) {
        console.error('Canvas or tagsContainer not found');
        return;
    }

    if (typeof TagCanvas === 'undefined') {
        console.error('TagCanvas is not loaded');
        return;
    }
    

    // Populate the tags container
    tagsContainer.innerHTML = '';
    member.forEach(participant => {
        const a = document.createElement('a');
        a.href = '#';
        a.textContent = participant.name;
        tagsContainer.appendChild(a);
    });

    try {
        TagCanvas.Start('lottery-canvas-main', 'tagsContainer', {
            textColour: '#ffffff',
            outlineColour: '#000000',
            outlineThickness: 1,
            initial: [0.03, -0.02],
            maxSpeed: 0.05,
            depth: 0.8,
            dragControl: true,
            wheelZoom: false,
            shuffleTags: true,
            noSelect: true,
            textHeight: 14,
            reverse: true,
            fadeIn: 1000,
            shadow: '#000',
            weight: true
        });

        tagsContainer.remove();
    } catch(e) {
        console.error('TagCanvas initialization failed:', e);
    }
}

window.addEventListener('DOMContentLoaded', initializeMainCanvas);
</script>

