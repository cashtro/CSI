<style>
 /* Styles pour les cartes verticales */
.counter-wrapper-vertical {
    padding-top: 0 !important;
    height: 100% !important;
    display: flex !important;
    flex-direction: column !important;
}

@media (max-width: 991px) {
    .counter-wrapper-vertical {
        padding-top: 30px !important;
    }
}

/* Styles réduits pour les cartes */
.counter-wrapper-vertical .counter-box-items {
    border-radius: 15px !important;
    border: 1px solid #434343 !important;
    margin-left: 20% !important;
    background: #222 !important;
    padding: 30px !important;
    margin-bottom: 15px !important;
    height: auto !important;
    max-width: 50% !important;
    transition: all 0.3s ease !important; /* Transition douce pour tous les effets */
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2) !important; /* Légère ombre par défaut */
}

/* Effet hover - carte complète */
.counter-wrapper-vertical .counter-box-items:hover {
    transform: translateY(-5px) !important; /* Léger mouvement vers le haut */
    box-shadow: 0 8px 15px rgba(0, 0, 0, 0.3) !important; /* Ombre plus prononcée */
    border-color: #E6C373 !important; /* Bordure dorée */
}

/* Effet hover - changement de couleur du texte */
.counter-wrapper-vertical .counter-box-items:hover h3 {
    color: #E6C373 !important; /* Même couleur dorée que dans les titres */
}

.counter-wrapper-vertical .counter-box-items h3 {
    color: var(--white) !important;
    font-size: 18px !important;
    margin-bottom: 5px !important;
    transition: color 0.3s ease !important; /* Transition douce pour le changement de couleur */
}

.counter-wrapper-vertical .counter-box-items p {
    font-size: 16px !important;
    font-weight: 500 !important;
    color: var(--white) !important;
    text-transform: uppercase !important;
}

/* Ajustements responsifs */
@media (max-width: 767px) {
    .counter-wrapper-vertical .counter-box-items {
        padding: 20px !important;
        margin-bottom: 10px !important;
        margin-right: 15% !important;
        max-width: 100% !important;
    }
    
    .counter-wrapper-vertical .counter-box-items h3 {
        font-size: 16px !important;
    }
}


.hero1 {
  padding-top: 40px !important;
  padding-bottom: 0 !important;
  margin-bottom: 0 !important;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.hero1 > * {
  margin-bottom: 0 !important;
  box-sizing: inherit;
}

.content1 {
  position: relative !important;
  z-index: 10 !important;
  margin-top: 4% !important;  /* Réglage fin */
  margin-bottom: 0 !important;
}

.robot-3d {
  display: block;
  width: 100% !important;
  max-height: 600px !important;
  margin: 0 auto;
  margin-top: -30% !important; /* Fait remonter légèrement le robot */
  margin-bottom: -40px !important; /* Réduit l'espace avec la section suivante */
}

@media (max-width: 768px) {
  .content1 {
    margin-top: 2% !important;
    position: relative;
    z-index: 2;
    /* Ajout pour l'espace */
    min-height: 40vh; /* Réserve de l'espace vertical */
  }

  .robot-3d {
    max-height: 100% !important;
    margin-top: 120% !important;
    margin-left: 0 !important; /* Suppression du margin-left */
    position: absolute !important;
    bottom: -10% !important;
    left: 20% !important;
    transform: translateX(-50%) scale(1.2) translateY(20%) !important; /* Ajout translation verticale */
    width: 100% !important; /* Réduction de la largeur */
    height: auto !important;
    z-index: 1;
    right: 0; /* Assurance centrage */
    margin-right: 0 !important;
  }

  .hero1 {
    padding-top: 20px !important;
    display: flex;
    flex-direction: column;
    /* Ajout pour container */
    min-height: 100vh !important; /* Garantit l'espace */
    overflow: visible !important;
  }
}

@media (max-width: 767px) {
  .choose-us-section .container {
      background: none !important;
  }
}

@media (max-width: 767px) {
  .world .container {
      background: none !important;
  }
}



</style>


