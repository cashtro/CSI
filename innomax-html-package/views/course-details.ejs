                // Mettre à jour l'interface des étapes
                function updateStepUI() {
                    steps.forEach(step => {
                        const stepNum = parseInt(step.dataset.step);
                        step.classList.toggle('active', stepNum <= currentStep);
                    });
                    
                    stepContents.forEach(content => {
                        content.classList.remove('active');
                    });
                    document.querySelector(`.step-${currentStep}-content`).classList.add('active');
                    
                    if (currentStep === 1) {
                        prevBtn.style.display = 'none';
                        nextBtn.textContent = 'Next';
                        nextBtn.disabled = !isUserLoggedIn();
                    } else if (currentStep === 2) {
                        prevBtn.style.display = 'inline-block';
                        nextBtn.textContent = 'Next';
                        nextBtn.disabled = !selectedTimeSlot;
                    } else if (currentStep === 3) {
                        prevBtn.style.display = 'inline-block';
                        nextBtn.textContent = 'Confirm';
                    }
                }

                // Vérifier si l'utilisateur est connecté
                function isUserLoggedIn() {
                    return document.querySelector('.alert.alert-success') !== null;
                }

                // Navigation des étapes
                nextBtn.addEventListener('click',async ()=>  {
                    if (currentStep === 1) {
                        // Passer à l'étape 2 et charger les disponibilités
                        currentStep++;
                        updateStepUI();
                        loadTeachersAvailability();
                    } 
                    else if (currentStep === 2) {
                        // Vérifier qu'un créneau a été sélectionné
                        if (!selectedTimeSlot || !selectedDisponibiliteId) {
                            alert('Please select an available time slot before continuing.');
                            return;
                        }
                        currentStep++;
                        updateStepUI();
                    }
                    else if (currentStep === 3) {
                        // Confirmer le rendez-vous
                        createAppointment();
                    }
                });

                prevBtn.addEventListener('click', function() {
                    if (currentStep > 1) {
                        currentStep--;
                        updateStepUI();
                    }
                });

                // Créer le rendez-vous
                const createAppointment = async () =>{
    nextBtn.innerHTML = '<div class="loading"></div> Processing...';
    nextBtn.disabled = true;

    // Modifier cette ligne - changer '/api/rendezvous' en '/api/rdv/create'
    const response = await fetch('/api/rdv/create', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${localStorage.getItem('accessToken')|| sessionStorage.getItem('accessToken')}`
        },
        body: JSON.stringify({
            disponibilite_id: selectedDisponibiliteId // Uniquement le champ nécessaire
        })
    })
    
    if (!response.ok) {
        const text = await response.text();
        throw new Error(text || 'Failed to create appointment');
    }
    
    const stripe = Stripe("<%= stripePublicKey%>");
                            
    const data = await response.json();
    if(data && data.id) {
      const stripe = Stripe("<%= stripePublicKey%>");
      const { error } = await stripe.redirectToCheckout({ sessionId: data.id });
      if (error) {
        console.error('Erreur Stripe:', error);
        nextBtn.textContent = 'Next';
        nextBtn.disabled = false;
      }
    }
    
        if (data.success) {
            // Afficher le message de confirmation
            const confirmationMessage = `
                <div class="confirmation-message">
                    <i class="fas fa-check-circle pulse"></i>
                    <h3>Appointment Confirmed!</h3>
                    <p>Your meeting with ${selectedTeacher} has been scheduled for:</p>
                    <p id="confirmedDateTime" class="text-primary">${document.getElementById('selectedDateTime').textContent}</p>
                    <p>Meeting link will be sent to your email.</p>
                </div>
            `;
            
            document.querySelector('.step-3-content').innerHTML = confirmationMessage;
            nextBtn.textContent = 'Close';
            nextBtn.disabled = false;
            nextBtn.onclick = function() {
                modal.style.display = 'none';
                location.reload();
            };
        } else {
            throw new Error(data.message || 'Failed to create appointment');
        }
    }

                // Ouvrir le modal
                openModalBtn.addEventListener('click', function() {
                    modal.style.display = 'block';
                    currentStep = 1;
                    selectedTimeSlot = null;
                    selectedDisponibiliteId = null;
                    selectedTeacher = null;
                    updateStepUI();
                    checkLoginStatus();
                });

                // Fermer le modal
                closeModalBtn.addEventListener('click', function() {
                    modal.style.display = 'none';
                });

                // Fermer le modal si on clique en dehors
                window.addEventListener('click', function(event) {
                    if (event.target == modal) {
                        modal.style.display = 'none';
                    }
                });

                // Gérer le formulaire de contact existant
                document.querySelector('.contact-form').addEventListener('submit', function(event) {
                    event.preventDefault();
                    const submitBtn = this.querySelector('button[type="submit"]');
                    const originalBtnText = submitBtn.innerHTML;

                    submitBtn.disabled = true;
                    submitBtn.querySelector('span:first-child').innerHTML = '<div class="loading"></div> Sending...';

                    setTimeout(() => {
                        alert('Your message has been sent successfully! We will contact you shortly.');
                        this.reset();
                        submitBtn.disabled = false;
                        submitBtn.querySelector('span:first-child').innerHTML = originalBtnText;
                    }, 1500);
                });
            });
        </script>

        <style>
            /* Animation flottante pour les particules */
            @keyframes float {
                0% {
                    transform: translateY(0px) translateX(0px);
                }

                25% {
                    transform: translateY(-15px) translateX(10px);
                }

                50% {
                    transform: translateY(0px) translateX(20px);
                }

                75% {
                    transform: translateY(15px) translateX(10px);
                }

                100% {
                    transform: translateY(0px) translateX(0px);
                }
            }

            /* Style pour les particules */
            .particles-container {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                z-index: -1;
                overflow: hidden;
            }

            .particle {
                position: absolute;
                background: linear-gradient(145deg, #855e1b, #e6c373);
                border-radius: 50%;
                box-shadow: 0 0 10px rgba(230, 195, 115, 0.3);
                pointer-events: none;
            }

            /* Animation de révélation */
            .reveal {
                position: relative;
                opacity: 0;
                transform: translateY(30px);
                transition: all 1s ease;
            }

            .reveal.active {
                opacity: 1;
                transform: translateY(0);
            }

            /* Effet de lueur */
            .glow-effect {
                box-shadow: 0 0 20px rgba(133, 94, 27, 0.2);
                transition: box-shadow 0.3s;
            }

            .glow-effect:hover {
                box-shadow: 0 0 30px rgba(230, 195, 115, 0.3);
            }

            /* Animation pour les boutons */
            .btn-shimmer {
                position: relative;
                overflow: hidden;
            }

            .btn-shimmer::after {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: linear-gradient(to right,
                        rgba(255, 255, 255, 0) 0%,
                        rgba(255, 255, 255, 0.3) 50%,
                        rgba(255, 255, 255, 0) 100%);
                transform: rotate(30deg);
                transition: all 0.6s;
                opacity: 0;
            }

            .btn-shimmer:hover::after {
                opacity: 1;
                transform: rotate(30deg) translate(100%, -100%);
            }

            /* Bouton désactivé */
            .modal-btn.disabled {
                opacity: 0.5;
                cursor: not-allowed;
            }
        </style>
</body>

</html>