    <!-- Style pour le modal de rendez-vous -->
    <style>
        /* Style du modal */
        .appointment-modal {
            display: none;
            position: fixed;
            z-index: 9999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(5px);
        }

        .modal-content {
            position: relative;
            background: linear-gradient(145deg, #0a0b1a, #121430);
            margin: 5% auto;
            padding: 30px;
            border: 1px solid #855e1b;
            border-radius: 10px;
            width: 80%;
            max-width: 800px; /* Augmenté pour plus d'espace */
            box-shadow: 0 0 20px rgba(133, 94, 27, 0.5);
            animation: modalFadeIn 0.4s;
            color: #ffffff;
        }

        @keyframes modalFadeIn {
            from {
                opacity: 0;
                transform: translateY(-30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .close-modal {
            position: absolute;
            right: 15px;
            top: 10px;
            font-size: 28px;
            color: #855e1b;
            cursor: pointer;
            transition: 0.3s;
        }

        .close-modal:hover {
            color: #e6c373;
            transform: rotate(90deg);
        }

        .modal-header {
            border-bottom: 1px solid rgba(133, 94, 27, 0.3);
            padding-bottom: 15px;
            margin-bottom: 20px;
        }

        .modal-header h2 {
            margin: 0;
            color: #e6c373;
            font-size: 24px;
        }

        .modal-body {
            margin-bottom: 20px;
        }

        .modal-footer {
            border-top: 1px solid rgba(133, 94, 27, 0.3);
            padding-top: 15px;
            text-align: right;
        }

        .modal-section {
            margin-bottom: 25px;
        }

        .modal-section h3 {
            color: #e6c373;
            margin-bottom: 15px;
            font-size: 20px;
        }

        /* Style pour les étapes du processus */
        .appointment-steps {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
            position: relative;
        }

        .appointment-steps::before {
            content: '';
            position: absolute;
            top: 15px;
            left: 50px;
            right: 50px;
            height: 2px;
            background: rgba(133, 94, 27, 0.5);
            z-index: 1;
        }

        .step {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #0a0b1a;
            border: 2px solid #855e1b;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 2;
            transition: all 0.3s ease;
        }

        .step.active {
            background: #855e1b;
            border-color: #e6c373;
            box-shadow: 0 0 10px rgba(230, 195, 115, 0.7);
        }

        .step-content {
            display: none;
            opacity: 0;
            transition: opacity 0.5s ease;
        }

        .step-content.active {
            display: block;
            opacity: 1;
        }

        /* Style pour le calendrier */
        .calendar-container {
            background: rgba(10, 11, 26, 0.7);
            border-radius: 8px;
            padding: 15px;
            border: 1px solid rgba(133, 94, 27, 0.5);
        }

        .time-slots {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 10px;
            margin-top: 15px;
        }

        .time-slot {
            background: rgba(18, 20, 48, 0.8);
            border: 1px solid rgba(133, 94, 27, 0.3);
            border-radius: 5px;
            padding: 8px 12px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
        }

        .time-slot:hover {
            background: rgba(133, 94, 27, 0.2);
            border-color: #855e1b;
        }

        .time-slot.selected {
            background: #855e1b;
            border-color: #e6c373;
            color: #ffffff;
        }

        .time-slot.unavailable {
            background: rgba(255, 0, 0, 0.1);
            border-color: rgba(255, 0, 0, 0.3);
            color: #ff6b6b;
            cursor: not-allowed;
        }

        .time-slots-container {
            max-height: 400px;
            overflow-y: auto;
            padding: 10px;
            background: rgba(10, 11, 26, 0.7);
            border-radius: 8px;
            border: 1px solid rgba(133, 94, 27, 0.5);
        }

        /* Style pour les boutons */
.modal-btn, .btn-enroll {
    background: linear-gradient(145deg, #855e1b, #e6c373);
    color: #000000;
    border: none;
    padding: 15px 30px; /* Augmenté pour rendre le bouton plus grand */
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.3s;
    margin-left: 10px;
    font-weight: 600;
    font-size: 18px; /* Taille de police augmentée */
    min-width: 200px; /* Largeur minimale définie */
    text-align: center; /* Centrer le texte */
}

.modal-btn:hover, .btn-enroll:hover {
    background: linear-gradient(145deg, #e6c373, #855e1b);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    color: #ffffff;
    padding: 16px 32px; /* Légèrement plus grand au survol */
}

.modal-btn-secondary {
    background: transparent;
    border: 1px solid #855e1b;
    color: #e6c373;
}

.modal-btn-secondary:hover {
    background: rgba(133, 94, 27, 0.2);
    border-color: #e6c373;
}

        /* Style pour la section de confirmation */
        .confirmation-message {
            text-align: center;
            padding: 20px;
        }

        .confirmation-message i {
            font-size: 48px;
            color: #e6c373;
            margin-bottom: 15px;
            display: block;
        }

        /* Label pour l'utilisateur non connecté */
        .login-required {
            background: rgba(255, 0, 0, 0.1);
            border: 1px solid rgba(255, 0, 0, 0.3);
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
            text-align: center;
        }

        .login-required i {
            color: #ff6b6b;
            margin-right: 10px;
        }

        .login-btn {
            display: inline-block;
            background: #855e1b;
            color: #ffffff;
            padding: 8px 20px;
            border-radius: 5px;
            margin-top: 10px;
            transition: all 0.3s;
            text-decoration: none;
        }

        .login-btn:hover {
            background: #e6c373;
            color: #000000;
            transform: translateY(-2px);
        }

        /* Effet de chargement */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255, 255, 255, .3);
            border-radius: 50%;
            border-top-color: #e6c373;
            animation: spin 1s ease-in-out infinite;
            margin-right: 10px;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* Style pour les cartes de professeurs dans le modal */
        .teacher-time-slots {
            display: grid;
            gap: 20px;
        }

        .teacher-slot {
            background: rgba(18, 20, 48, 0.8);
            border-radius: 8px;
            padding: 15px;
            border: 1px solid rgba(133, 94, 27, 0.3);
        }

        .teacher-header {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }

        .teacher-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #855e1b;
            margin-right: 10px;
        }

        .teacher-name {
            color: #e6c373;
            font-weight: bold;
        }

        .teacher-times {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 8px;
        }

        .teacher-time {
            background: rgba(10, 11, 26, 0.7);
            border: 1px solid rgba(133, 94, 27, 0.3);
            border-radius: 4px;
            padding: 6px 8px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 13px;
        }

        .teacher-time:hover {
            background: rgba(133, 94, 27, 0.3);
        }

        .teacher-time.selected {
            background: #855e1b;
            border-color: #e6c373;
            color: #fff;
        }

        .teacher-time.unavailable {
            background: rgba(255, 0, 0, 0.1);
            border-color: rgba(255, 0, 0, 0.3);
            color: #ff6b6b;
            cursor: not-allowed;
            text-decoration: line-through;
        }
    </style>
</head>

