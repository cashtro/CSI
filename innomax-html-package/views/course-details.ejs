                            <h2>Enrollment Options</h2>
                <p style="font-size: 18px; line-height: 1.6; margin-bottom: 25px; font-weight: 500; color: #ffffff;">Choose the payment option that works best for you:</p>
                
                <div style="display: flex; justify-content: center; gap: 20px; margin-top: 30px; flex-wrap: wrap;">
                    <!-- One-time payment button with gold style -->
                    <form id="regular-enroll-form">
                        <button type="submit" class="btn-enroll" style="font-size: 22px; padding: 18px 36px; min-width: 250px; box-shadow: 0 0 15px rgba(230, 195, 115, 0.5); background: linear-gradient(145deg, #855e1b, #e6c373); color: #000000; border: none; border-radius: 5px; font-weight: 600; transition: all 0.3s;">
                            Buy  <%= data.prix %>$
                        </button>
                    </form>
                    
                    <!-- Subscription button with gold style -->
                    <form id="subscription-enroll-form">
                        <input type="hidden" name="course_id" value="<%=data.id%>">
                        <button type="submit" class="btn-enroll" style="font-size: 22px; padding: 18px 36px; min-width: 250px; box-shadow: 0 0 15px rgba(230, 195, 115, 0.5); background: linear-gradient(145deg, #855e1b, #e6c373); color: #000000; border: none; border-radius: 5px; font-weight: 600; transition: all 0.3s;">
                            Subscribe for <%= data.prix/5 %>$/month
                        </button>
                    </form>
                </div>
                
                <p class="course-meta" style="margin-top: 20px; font-size: 18px; color: #ffffff;"><i class="fas fa-lock" style="margin-right: 8px;"></i> Secure payment via Stripe</p>
            </div>

                            <script>
                                const stripe = Stripe("<%= stripePublicKey%>");
                            
                                document.addEventListener('DOMContentLoaded', function() {
    // Attacher l'événement à TOUS les formulaires avec l'ID "regular-enroll-form"
    document.querySelectorAll('#regular-enroll-form').forEach(form => {
        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            try {
                const response = await fetch(`/api/course/<%=data.id%>/enroll`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`
                    }
                });
                
                if (!response.ok) {
                    console.error(response);
                    throw new Error('Failed to create enrollment session');
                }
                
                const data = await response.json();
                if (data && data.id) {
                    const { error } = await stripe.redirectToCheckout({ sessionId: data.id });
                    if (error) {
                        console.error("Stripe Checkout error:", error);
                        throw error;
                    }
                }
            } catch (error) {
                console.error("Error during enrollment:", error);
                alert("Payment error: " + error.message);
            }
        });
    });
});
                            
                                document.getElementById('subscription-enroll-form').addEventListener('submit', async function (e) {
                                    e.preventDefault();
                                    try {
                                        const response = await fetch('/api/course/<%=data.id%>/subscribe', {
                                            method: 'POST',
                                            headers: {
                                                'Content-Type': 'application/json',
                                                'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`
                                            }
                                        });
                            
                                        if (!response.ok) {
                                            throw new Error(await response.text());
                                        }
                            
                                        const { id: sessionId } = await response.json();
                                        const { error } = await stripe.redirectToCheckout({ sessionId });
                                        if (error) {
                                            console.error("Stripe Subscription error:", error);
                                        }
                                        return response.json();
                                    } catch (error) {
                                        alert("Subscription error: " + error.message);
                                    }
                                });
                            </script>

