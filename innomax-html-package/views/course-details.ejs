        <script>
            document.addEventListener('DOMContentLoaded', function async () {
                // Animation des éléments au défilement
                function revealElements() {
                    const reveals = document.querySelectorAll('.reveal');

                    for (let i = 0; i < reveals.length; i++) {
                        const windowHeight = window.innerHeight;
                        const elementTop = reveals[i].getBoundingClientRect().top;
                        const elementVisible = 150;

                        if (elementTop < windowHeight - elementVisible) {
                            reveals[i].classList.add('active');
                        }
                    }
                }

                window.addEventListener('scroll', revealElements);
                revealElements();

                // Créer des particules d'arrière-plan
                function createParticles() {
                    const particleCount = 50;
                    const particlesContainer = document.querySelector('.particles-container');

                    for (let i = 0; i < particleCount; i++) {
                        const particle = document.createElement('div');
                        particle.classList.add('particle');

                        const size = Math.random() * 5 + 1;
                        particle.style.width = `${size}px`;
                        particle.style.height = `${size}px`;

                        const posX = Math.random() * window.innerWidth;
                        const posY = Math.random() * window.innerHeight;
                        particle.style.left = `${posX}px`;
                        particle.style.top = `${posY}px`;

                        particle.style.opacity = Math.random() * 0.5 + 0.1;

                        const animDuration = Math.random() * 20 + 10;
                        particle.style.animation = `float ${animDuration}s linear infinite`;
                        particle.style.animationDelay = `${Math.random() * 5}s`;

                        particlesContainer.appendChild(particle);
                    }
                }

                createParticles();

                // Script pour le modal de rendez-vous
                const modal = document.getElementById('appointmentModal');
                const openModalBtn = document.getElementById('openAppointmentModal');
                const closeModalBtn = document.querySelector('.close-modal');
                const nextBtn = document.getElementById('nextBtn');
                const prevBtn = document.getElementById('prevBtn');
                const steps = document.querySelectorAll('.step');
                const stepContents = document.querySelectorAll('.step-content');

                let currentStep = 1;
                let selectedTimeSlot = null;
                let selectedDate = null;
                let selectedDisponibiliteId = null;
                let selectedTeacher = null;

                // Fonction pour vérifier si l'utilisateur est connecté
                function checkLoginStatus() {
                    const loginStatusDiv = document.getElementById('loginStatus');

                    fetch('/api/auth/validateToken', {
                        method: 'GET',
                        credentials: 'include',
                        headers: {
                            'Authorization': `Bearer ${localStorage.getItem('accessToken') || ''}`
                        }
                    })
                        .then(response => {
                            if (!response.ok) throw new Error('Not authenticated');
                            return response.json();
                        })
                        .then(data => {
                            if (data.success) {
                                loginStatusDiv.innerHTML = `
                                    <div class="alert alert-success">
                                        <i class="fas fa-check-circle"></i> You are logged in. Click "Next" to select an available time slot.
                                    </div>
                                `;
                                nextBtn.disabled = false;
                                nextBtn.classList.remove('disabled');
                            } else {
                                throw new Error('Not logged in');
                            }
                        })
                        .catch(error => {
                            console.error('Error checking auth status:', error);
                            loginStatusDiv.innerHTML = `
                                <div class="login-required">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    <h3>Login Required</h3>
                                    <p>You need to be logged in to schedule an appointment with the instructor.</p>
                                    <a href="/login?redirect=${encodeURIComponent(window.location.pathname)}" class="login-btn">
                                        <i class="fas fa-sign-in-alt"></i> Login to Continue
                                    </a>
                                </div>
                            `;
                            nextBtn.disabled = true;
                            nextBtn.classList.add('disabled');
                        });
                }

                function loadTeachersAvailability() {
    const container = document.getElementById('teacherTimeSlots');
    container.innerHTML = '<div class="text-center w-100"><div class="loading"></div> Loading available time slots...</div>';

    fetch(`/api/auth/validateToken`, {
        headers: {
            'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`,
        }
    }).then(response => {
        if (!response.ok) {
            throw new Error('Token invalide ou expiré');
        }
        return response.json();
    }).then(authData => {
        if (!authData.success || !authData.userid) {
            throw new Error(authData.error || 'Échec de l\'authentification');
        }
        return authData.userid;
    })
    .then(userId => { //fuck up sale, nrmlm c id prof pas id user bruh
        return fetch(`/api/dispo/disponibilite?user_id=<%=data.id_prof%>`)
        .then(response => {
            if (!response.ok) throw new Error(`Erreur HTTP: ${response.status}`);
            return response.json();
        });
    }).then(allAvailability => {
        
        if (!allAvailability || !Array.isArray(allAvailability)) {
            container.innerHTML = `
            <div class="alert alert-warning w-100 text-center">
                <i class="fas fa-exclamation-triangle"></i> Format de données incorrect.
                <p>Détails: ${JSON.stringify(allAvailability)}</p>
            </div>`;
            return;
        }
        
        if (allAvailability.length === 0) {
            container.innerHTML = `
            <div class="alert alert-info w-100 text-center">
                <i class="fas fa-info-circle"></i> Aucune disponibilité trouvée dans le système.
            </div>`;
            return;
        }
        
        const now = new Date(); // Date actuelle en UTC

        const validAvailability = allAvailability.filter(slot => {
    const startTimeUTC = new Date(slot.start_time);
    
    // Conversion de 'now' en timestamp UTC
    const nowUTC = now.getTime();
    
    // Vérification du type de 'taken' (doit être booléen)
    const isTaken = slot.taken === true; // ou vérifier si c'est une chaîne "true"
    
    // Comparaison en UTC
    const isValid = !isTaken && startTimeUTC.getTime() > nowUTC;
   

    return isValid;
});
        
        if (validAvailability.length === 0) {
            container.innerHTML = `
            <div class="alert alert-info w-100 text-center">
                <i class="fas fa-info-circle"></i> Toutes les disponibilités sont prises ou expirées.
            </div>`;
            return;
        
            const nowUTC = new Date().getTime(); // Timestamp UTC actuel

            const validAvailability = allAvailability.filter(slot => {
            const startTimeUTC = new Date(slot.start_time).getTime();
            const isTaken = slot.taken === true; // Assurez-vous que 'taken' est un booléen
            return !isTaken && startTimeUTC > nowUTC;
});

        if (validAvailability.length === 0){
            container.innerHTML = `
            <div class="alert alert-info w-100 text-center">
                <i class="fas fa-info-circle"></i> Toutes les disponibilités sont prises ou expirées.
            </div>
            `;
            return;
        }
    }
        const teachersMap = validAvailability.reduce((map, slot) => {
            const professorId = slot.id_prof
            if(!map.has(professorId)){
                map.set(professorId, {
                    id: professorId,
                    username: slot.Users?.username || `Professeur ${professorId}`,
                    avatar: slot.Users?.avatar || 'assets/img/logo/pp.webp',
                    availability: []
                });
            }
            map.get(professorId).availability.push(slot);
            return map;
        }, new Map());
        
        container.innerHTML = ''; // Vider le conteneur 
        teachersMap.forEach(teacher => {
            createTeacherAvailabilityCard(teacher, container);
        });
    })
    .catch(error => {
        console.error('Error loading availability:', error);
        container.innerHTML = `
            <div class="alert alert-danger w-100 text-center">
                <i class="fas fa-exclamation-circle"></i> Error loading availability.
                <p class="small">${error.message}</p>
            </div>`;
    });
}



function createTeacherAvailabilityCard(teacher, container) {
    const teacherSlot = document.createElement('div');
    teacherSlot.className = 'teacher-slot';

    const teacherHeader = document.createElement('div');
    teacherHeader.className = 'teacher-header';

    const avatar = document.createElement('img');
    avatar.className = 'teacher-avatar';
    avatar.src = teacher.avatar;
    avatar.alt = teacher.username;

    const name = document.createElement('span');
    name.className = 'teacher-name';
    name.textContent = teacher.username;

    teacherHeader.appendChild(avatar);
    teacherHeader.appendChild(name);
    teacherSlot.appendChild(teacherHeader);

    const timesContainer = document.createElement('div');
    timesContainer.className = 'teacher-times';

    teacher.availability.forEach(slot => {
        const startTime = new Date(slot.start_time);
        const endTime = new Date(slot.end_time);
        
        const timeString = `${startTime.toLocaleDateString()} ${startTime.getHours().toString().padStart(2, '0')}:${startTime.getMinutes().toString().padStart(2, '0')} - ${endTime.getHours().toString().padStart(2, '0')}:${endTime.getMinutes().toString().padStart(2, '0')}`;
        
        const timeElement = document.createElement('div');
        timeElement.className = 'teacher-time';
        timeElement.textContent = timeString;
        timeElement.dataset.start = slot.start_time;
        timeElement.dataset.end = slot.end_time;
        timeElement.dataset.disponibilite_id = slot.id;
        timeElement.dataset.teacher_id = teacher.id;
        timeElement.dataset.teacher_name = teacher.username;

        // Vérifier si le créneau est déjà passé
        const now = new Date();
        if (startTime < now) {
            timeElement.classList.add('unavailable');
            timeElement.title = 'This time slot has already passed';
        }

        timeElement.addEventListener('click', function() {
            if (this.classList.contains('unavailable')) return;
            
            document.querySelectorAll('.teacher-time').forEach(t => {
                t.classList.remove('selected');
            });
            this.classList.add('selected');
            
            selectedTimeSlot = timeString;
            selectedDisponibiliteId = this.dataset.disponibilite_id;
            selectedTeacher = this.dataset.teacher_name;
            selectedTeacherId = this.dataset.teacher_id;
            selectedDate = new Date(slot.start_time).toISOString().split('T')[0];
            
            document.getElementById('selectedDateTime').textContent = 
                `${selectedDate} at ${timeString}`;
            document.getElementById('selectedTeacherName').textContent = 
                teacher.username;
            
            nextBtn.disabled = false;
            nextBtn.classList.remove('disabled');
        });

        timesContainer.appendChild(timeElement);
    });

    teacherSlot.appendChild(timesContainer);
    container.appendChild(teacherSlot);
}
