                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        const scrollContainer = document.querySelector('.services-horizontal-scroll');
                        const prevBtn = document.querySelector('.scroll-control.prev');
                        const nextBtn = document.querySelector('.scroll-control.next');
                        const slides = document.querySelectorAll('.service-slide');
                        const indicators = document.querySelectorAll('.indicator');
                        let currentIndex = 0;
                        const slideCount = slides.length;

                        // Fonction pour mettre à jour les indicateurs
                        function updateIndicators(index) {
                            indicators.forEach((indicator, i) => {
                                indicator.classList.toggle('active', i === index);
                            });
                        }

                        // Fonction pour faire défiler vers un slide spécifique
                        function goToSlide(index) {
                            currentIndex = (index + slideCount) % slideCount; // Gère les index négatifs
                            const slideWidth = slides[0].offsetWidth + 20; // Inclut la marge
                            scrollContainer.scrollTo({
                                left: currentIndex * slideWidth,
                                behavior: 'smooth'
                            });
                            updateIndicators(currentIndex);
                        }

                        // Navigation précédente (cyclique)
                        prevBtn.addEventListener('click', () => {
                            goToSlide(currentIndex - 1);
                        });

                        // Navigation suivante (cyclique)
                        nextBtn.addEventListener('click', () => {
                            goToSlide(currentIndex + 1);
                        });

                        // Gestion du clic sur les indicateurs
                        indicators.forEach((indicator, index) => {
                            indicator.addEventListener('click', () => {
                                goToSlide(index);
                            });
                        });

                        // Détection du slide actuel au scroll
                        scrollContainer.addEventListener('scroll', () => {
                            const slideWidth = slides[0].offsetWidth + 20;
                            currentIndex = Math.round(scrollContainer.scrollLeft / slideWidth);
                            updateIndicators(currentIndex);
                        });

                        // Initialisation
                        updateIndicators(0);
                    });
                </script>

