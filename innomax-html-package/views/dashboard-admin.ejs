            </div>
    
            <div class="content-body">
                <h3>Pending Requests</h3>
                <div id="pending-requests" class="content-card">Loading...</div>
    
                <h3>Current Teachers</h3>
                <div id="current-teachers" class="content-card">Loading...</div>
