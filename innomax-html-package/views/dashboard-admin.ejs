    <script>
        document.addEventListener('DOMContentLoaded', function () {
    async function loadTeacherData() {
        try {
            const requestsRes = await fetch('/api/teacher/requests', {
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`
                }
            });
            const requests = await requestsRes.json();

             const teachersRes = await fetch('/api/teacher/users?role=teacher', {
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`
                }
            });
            const teachers = await teachersRes.json();

            renderRequests(requests);
            renderTeachers(teachers);
        } catch (err) {
            console.error(err);
            document.getElementById('pending-requests').innerHTML = 'Error loading requests';
            document.getElementById('current-teachers').innerHTML = 'Error loading teachers';
        }
    }

    function renderRequests(requests) {
        const container = document.getElementById('pending-requests');
        if (!requests.length) return container.innerHTML = "No pending requests.";

        container.innerHTML = requests.map(req => `
            <div class="request-card">
                
                <p>Message: </br>${req.message}</p>
                <button onclick="acceptRequest('${req.id}')">Accept</button>
                <button onclick="refuseRequest('${req.id}')">Refuse</button>
            </div>
        `).join('');
    }

    function renderTeachers(teachers) {
        const container = document.getElementById('current-teachers');
        if (!teachers.length) return container.innerHTML = "No current teachers.";

        container.innerHTML = teachers.map(user => `
            <div class="teacher-card">
                <p><strong>${user.username}</strong> (${user.email})</p>
                <button onclick="revokeTeacher('${user.userId}')">Revoke teacher access</button>
            </div>
        `).join('');
    }

    window.acceptRequest = async function (id) {
        const response = await fetch(`/api/teacher/acceptRequest/${id}`, { method: 'POST',
        headers:{
            'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`
            }
        });

        if (!response.ok) {
        const err = await response.json().catch(() => ({}));
        console.error(`Erreur lors de l'acceptation :`, response.status, err);
        alert(`Erreur: ${response.status} - ${(err && err.error) || 'Inconnu'}`);
        return;
    }


        loadTeacherData();
    }

    window.refuseRequest = async function (id) {
        const response = await fetch(`/api/teacher/refuseRequest/${id}`, { method: 'DELETE',
        headers:{
            'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`
            }
         });
        loadTeacherData();
    }

    window.revokeTeacher = async function (id) {
         
        const response = await fetch(`/api/teacher/revokeTeacher/${id}`, { method: 'POST',
        headers:{
            'Authorization': `Bearer ${localStorage.getItem('accessToken') || sessionStorage.getItem('accessToken')}`
            }
         });

          if (!response.ok) {
        const err = await response.json().catch(() => ({}));
        console.error(`Erreur lors de la révocation :`, response.status, err);
        alert(`Erreur: ${response.status} - ${(err && err.error) || 'Inconnu'}`);
        return;
    }
        loadTeacherData();
    }

    loadTeacherData();
});

    </script>
