    <!-- JavaScript for mobile navbar functionality -->
    <script>
        // Add event listeners to mobile navbar items
        document.querySelectorAll('.mobile-navbar .mobile-nav-item').forEach(item => {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                const page = this.dataset.page;
                showPage(page);
                setActiveMobileNavItem(page);
            });
        });
        
        // Function to set active class on mobile nav item
        function setActiveMobileNavItem(page) {
            document.querySelectorAll('.mobile-navbar .mobile-nav-item').forEach(item => {
                item.classList.remove('active');
                if(item.dataset.page === page) {
                    item.classList.add('active');
                }
            });
            
            // Vérifie si la fonction setActiveMenuItem existe avant de l'appeler
            if(typeof window.setActiveMenuItem === 'function') {
                setActiveMenuItem(page);
            }
        }
        
        // Modified showPage function to update both navigation systems
        function showPage(page) {
            // Hide all page content
            document.querySelectorAll('.page-content').forEach(content => {
                content.classList.remove('active');
            });
            
            // Show the selected page content
            const pageContent = document.getElementById(page + '-content');
            if (pageContent) {
                pageContent.classList.add('active');
                
                // Update page title from the clicked element's data-title attribute
                const activeElement = document.querySelector(`[data-page="${page}"]`);
                if (activeElement && activeElement.dataset.title) {
                    const pageTitle = document.querySelector('.page-title');
                    if (pageTitle) {
                        pageTitle.textContent = activeElement.dataset.title;
                    }
                }
            }
            
            // Update both navigation systems
            setActiveMobileNavItem(page);
        }
    
        // Initialisation au chargement de la page
        document.addEventListener('DOMContentLoaded', function() {
            // Active la page courante basée sur l'URL ou 'dashboard' par défaut
            const currentPage = window.location.hash.substring(1) || 'dashboard';
            showPage(currentPage);
        });
    </script>
